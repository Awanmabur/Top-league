<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8"/>
  <title>Login - Classic Academy</title>
  <meta name="viewport" content="width=device-width,initial-scale=1"/>
  <link rel="icon" href="/img/academylogo.png"/>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" crossorigin="anonymous" referrerpolicy="no-referrer"/>
  <style nonce="<%= cspNonce %>">
    :root{--primary:#4a90e2;--deep:#0a3d62;--soft:#eef8ff;--paper:#fff;--text:#132238;--muted:#667085;--line:#d9e8f5;--radius:30px;--shadow:0 24px 70px rgba(35,76,118,.14)}
    *{box-sizing:border-box} html,body{min-height:100%} body{margin:0;font-family:Outfit,system-ui,-apple-system,Segoe UI,Roboto,Arial,sans-serif;color:var(--text);background:#f7fbff}
    a{text-decoration:none;color:inherit}.page{min-height:100vh;display:grid;place-items:center;padding:28px}.login-shell{width:min(1040px,100%);display:grid;grid-template-columns:1fr 1fr;gap:0;border:1px solid var(--line);border-radius:var(--radius);overflow:hidden;background:var(--paper);box-shadow:var(--shadow)}
    .story,.form-card{min-height:570px}.story{position:relative;padding:38px;background:var(--soft);display:flex;flex-direction:column;justify-content:space-between;border-right:1px solid var(--line);overflow:hidden}.story:after{content:"";position:absolute;width:260px;height:260px;border-radius:50%;right:-90px;bottom:-100px;border:44px solid rgba(74,144,226,.10)}
    .brand{display:flex;align-items:center;gap:13px;position:relative;z-index:1}.brand img{width:52px;height:52px;object-fit:contain;border-radius:16px;background:#fff;padding:5px;border:1px solid var(--line)}.brand strong{display:block;font-size:18px}.brand span{font-size:12px;color:var(--muted)}
    .story-main{position:relative;z-index:1}.eyebrow{display:inline-flex;align-items:center;gap:8px;border:1px solid #cde0f1;border-radius:999px;padding:8px 12px;background:#fff;color:var(--deep);font-size:12px;font-weight:900}.story h1{font-size:clamp(32px,4vw,48px);line-height:1.02;margin:18px 0 12px;letter-spacing:-.035em}.story p{color:var(--muted);line-height:1.65;margin:0;max-width:48ch}.trust{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:24px}.trust div{background:#fff;border:1px solid var(--line);border-radius:18px;padding:13px;font-size:12px;font-weight:800;display:flex;gap:9px;align-items:center}.trust i{color:var(--primary)}
    .story-foot{position:relative;z-index:1;color:var(--muted);font-size:12px}.story-foot a{color:var(--primary);font-weight:900}
    .form-card{padding:42px;display:flex;flex-direction:column;justify-content:center;background:#fff}.form-card h2{margin:0;font-size:30px;letter-spacing:-.025em}.sub{color:var(--muted);font-size:13px;line-height:1.55;margin:8px 0 0}.serverErr{margin-top:15px;padding:11px 13px;border-radius:14px;border:1px solid #fecaca;background:#fff7f7;color:#991b1b;font-size:12px;font-weight:800;display:flex;gap:8px}.grid{display:grid;gap:14px;margin-top:24px}.field{display:grid;gap:7px}label{font-size:12px;font-weight:900;color:#475467}.input{display:flex;align-items:center;gap:10px;padding:12px 13px;border:1px solid var(--line);border-radius:999px;background:#fff;transition:.18s}.input:focus-within{border-color:#93bfe7;box-shadow:0 0 0 4px rgba(74,144,226,.10)}.input input{border:0;outline:0;background:transparent;width:100%;font:inherit;color:var(--text)}.icon{width:18px;text-align:center;color:#6f8195}.toggle{border:0;background:transparent;cursor:pointer;color:#60758a;width:38px;height:38px;display:grid;place-items:center;padding:0;border-radius:50%}.row{display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap}.remember{display:flex;align-items:center;gap:8px;margin:0;font-weight:700}.tiny{font-size:12px;color:var(--muted)}.help a{font-size:12px;color:var(--primary);font-weight:900}.btn{border:0;border-radius:999px;padding:14px 18px;font-weight:900;cursor:pointer;display:inline-flex;align-items:center;justify-content:center;gap:9px}.btn.primary{background:var(--primary);color:#fff}.btn.primary:hover{filter:brightness(.96)}.err{display:none;color:#b42318;font-size:12px;font-weight:800}.back{margin-top:18px;font-size:12px;color:var(--muted);text-align:center}.back a{color:var(--primary);font-weight:900}
    @media(max-width:820px){.page{padding:16px}.login-shell{grid-template-columns:1fr;border-radius:24px}.story,.form-card{min-height:unset}.story{padding:26px;border-right:0;border-bottom:1px solid var(--line)}.trust{grid-template-columns:1fr 1fr}.form-card{padding:28px}}
    @media(max-width:520px){.trust{grid-template-columns:1fr}.story h1{font-size:34px}.form-card{padding:24px}}
  </style>
  <link rel="stylesheet" href="/css/classic-motion.css">
</head>
<body>
<main class="page">
  <div class="login-shell">
    <section class="story">
      <div class="brand"><img src="/img/academylogo.png" alt="Classic Academy logo"><div><strong>Classic Academy</strong><span>School management + admissions</span></div></div>
      <div class="story-main">
        <span class="eyebrow"><i class="fa-solid fa-shield-halved"></i> Private administration workspace</span>
        <h1>Welcome back to Classic Academy.</h1>
        <p>Access school operations, subscriptions, support and platform settings from one secure workspace.</p>
        <div class="trust">
          <div><i class="fa-solid fa-user-shield"></i> Secure role access</div>
          <div><i class="fa-solid fa-clock-rotate-left"></i> Clear audit trail</div>
          <div><i class="fa-solid fa-chart-line"></i> Live platform insights</div>
          <div><i class="fa-solid fa-lock"></i> Protected sessions</div>
        </div>
      </div>
      <div class="story-foot">Classic Academy • <a href="/">Back to website</a></div>
    </section>
    <section class="form-card">
      <h2>Sign in to your account</h2><p class="sub">Use your Classic Academy administrator email and password.</p>
      <% if (error) { %><div class="serverErr"><i class="fa-solid fa-triangle-exclamation"></i><div><%= error %></div></div><% } %>
      <form method="post" action="/login" id="loginForm" class="grid" novalidate>
        <% if (typeof csrfToken !== "undefined" && csrfToken) { %><input type="hidden" name="_csrf" value="<%= csrfToken %>"/><% } %>
        <div class="field"><label for="loginId">Email</label><div class="input"><i class="fa-solid fa-envelope icon"></i><input id="loginId" type="email" name="email" value="<%= old?.email || '' %>" placeholder="email@example.com" autocomplete="username" required></div><div class="err" id="errId">Please enter your email.</div></div>
        <div class="field"><label for="password">Password</label><div class="input"><i class="fa-solid fa-key icon"></i><input id="password" type="password" name="password" placeholder="Password" autocomplete="current-password" required><button type="button" class="toggle" id="togglePw" aria-label="Show password"><i class="fa-regular fa-eye"></i></button></div><div class="err" id="errPw">Password is required.</div></div>
        <div class="row"><label class="remember"><input type="checkbox" name="remember" value="1"><span class="tiny">Remember me</span></label><div class="help"><a href="/forgot-password">Forgot password?</a></div></div>
        <button class="btn primary" type="submit"><i class="fa-solid fa-right-to-bracket"></i> Continue securely</button>
      </form>
      <div class="back">Looking for a school? <a href="/schools">Explore schools</a></div>
    </section>
  </div>
</main>
<script nonce="<%= cspNonce %>">
  const $=(id)=>document.getElementById(id);
  $('togglePw').addEventListener('click',()=>{const pw=$('password');const hidden=pw.type==='password';pw.type=hidden?'text':'password';$('togglePw').innerHTML=hidden?'<i class="fa-regular fa-eye-slash"></i>':'<i class="fa-regular fa-eye"></i>';$('togglePw').setAttribute('aria-label',hidden?'Hide password':'Show password');});
  $('loginForm').addEventListener('submit',(e)=>{const id=$('loginId').value.trim();const pw=$('password').value.trim();$('errId').style.display=id?'none':'block';$('errPw').style.display=pw?'none':'block';if(!id||!pw)e.preventDefault();});
</script>
<script src="/js/classic-motion.js" defer></script>
</body>
</html>
