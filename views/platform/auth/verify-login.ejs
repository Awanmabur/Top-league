<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8"/>
  <title>Verify Sign-in - Classic Academy</title>
  <meta name="viewport" content="width=device-width,initial-scale=1"/>
  <style nonce="<%= cspNonce %>">
    :root{--blue:#0a3d62;--accent:#0a6fbf;--bg:#f4f8ff;--card:#fff;--line:rgba(13,64,96,.12);--muted:#6b7280;--radius:18px;--shadow:0 12px 40px rgba(0,0,0,.10)}
    *{box-sizing:border-box}body{margin:0;font-family:system-ui,-apple-system,Segoe UI,Roboto,Arial;background:var(--bg);color:#0f172a}.wrap{min-height:100vh;display:grid;place-items:center;padding:18px}.card{width:min(520px,100%);background:var(--card);border-radius:var(--radius);box-shadow:var(--shadow);border:1px solid var(--line);padding:24px}.title{font-size:22px;font-weight:800;color:var(--blue)}.muted{color:var(--muted);font-size:13px;line-height:1.6;margin-top:6px}.input{margin-top:18px;padding:14px;border-radius:14px;border:1px solid var(--line);width:100%;font:inherit;text-align:center;font-size:24px;letter-spacing:6px}.btn{margin-top:18px;border:none;border-radius:14px;padding:12px 14px;font-weight:800;cursor:pointer;background:var(--accent);color:#fff;width:100%}.msg{margin-top:14px;color:#b91c1c;font-size:13px;font-weight:700}a{color:var(--accent);text-decoration:none;font-weight:700}
  </style>
</head>
<body>
  <div class="wrap"><div class="card">
    <div class="title">Verify your sign-in</div>
    <div class="muted">A six-digit verification code was sent to your Super Admin email. It expires in 10 minutes.</div>
    <% if (error) { %><div class="msg"><%= error %></div><% } %>
    <form method="post" action="/super-admin/verify-login">
      <% if (typeof csrfToken !== "undefined" && csrfToken) { %><input type="hidden" name="_csrf" value="<%= csrfToken %>" /><% } %>
      <label for="code" class="muted">Verification code</label>
      <input class="input" id="code" type="text" name="code" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9]{6}" maxlength="6" required />
      <button class="btn" type="submit">Verify & Sign In</button>
    </form>
    <div class="muted" style="margin-top:18px"><a href="/login">Start sign-in again</a></div>
  </div></div>
</body>
</html>
