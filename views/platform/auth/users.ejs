<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>Platform Users — Classic Academy</title>
  <link rel="stylesheet" href="/css/navbar.css" />
  <style nonce="<%= cspNonce %>">
    body{margin:0;background:#f5f8ff;font-family:Poppins,Segoe UI,Arial,sans-serif;color:#0f172a}.main{padding:20px 26px}.head{display:flex;justify-content:space-between;gap:12px;align-items:center;flex-wrap:wrap}.title{font-size:20px;font-weight:800;color:#083454}.btn{padding:10px 14px;border-radius:10px;border:1px solid #dbe3f6;background:#eef4ff;color:#0a3d62;text-decoration:none;font-weight:700;cursor:pointer}.card{margin-top:16px;background:#fff;border:1px solid #e4ecfb;border-radius:12px;overflow:auto}.table{width:100%;border-collapse:collapse;min-width:860px}.table th,.table td{padding:12px;border-bottom:1px solid #edf2fb;text-align:left;font-size:13px;vertical-align:middle}.table th{color:#526079;background:#f9fbff}.row-actions{display:flex;gap:8px;flex-wrap:wrap}.inline{display:flex;gap:6px;align-items:center}.inline select{padding:8px;border:1px solid #dbe3f6;border-radius:8px}.muted{color:#6b7280;font-size:12px}.badge{padding:5px 8px;border-radius:999px;font-size:11px;font-weight:800}.on{background:#dcfce7;color:#166534}.off{background:#fee2e2;color:#991b1b}.pager{margin-top:14px;display:flex;justify-content:space-between;align-items:center;gap:10px;flex-wrap:wrap}.pager-actions{display:flex;gap:8px}@media(max-width:900px){.main{padding:16px}}
  </style>
</head>
<body>
  <%- include("../partials/navbar") %>
  <main class="main">
    <div class="head"><div><div class="title">Platform Users</div><div class="muted">Roles and activation changes invalidate the affected user’s current sessions immediately.</div></div><a class="btn" href="/super-admin/platform-users/create">Create Platform User</a></div>
    <% if (error) { %><p><%= error %></p><% } %>
    <div class="card"><table class="table"><thead><tr><th>User</th><th>Role</th><th>Status</th><th>Last Login</th><th>Actions</th></tr></thead><tbody>
      <% (users || []).forEach(function(row){ %>
        <tr>
          <td><strong><%= row.name || ((row.firstName || '') + ' ' + (row.lastName || '')).trim() %></strong><div class="muted"><%= row.email %></div></td>
          <td><%= row.role %></td>
          <td><span class="badge <%= row.isActive ? 'on' : 'off' %>"><%= row.isActive ? 'Active' : 'Inactive' %></span></td>
          <td><%= row.lastLoginAt ? new Date(row.lastLoginAt).toLocaleString() : 'Never' %></td>
          <td><div class="row-actions">
            <% if (String(row._id) !== String(user?._id || '')) { %>
              <form class="inline" method="post" action="/super-admin/platform-users/<%= row._id %>/role">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>" /><input type="hidden" name="revision" value="<%= row.revision || 1 %>" />
                <select name="role"><% ["SuperAdmin","Operations","Support","Sales","Finance"].forEach(function(role){ %><option value="<%= role %>" <%= row.role === role ? 'selected' : '' %>><%= role %></option><% }) %></select>
                <button class="btn" type="submit">Change Role</button>
              </form>
              <form class="inline" method="post" action="/super-admin/platform-users/<%= row._id %>/status">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>" /><input type="hidden" name="revision" value="<%= row.revision || 1 %>" /><input type="hidden" name="isActive" value="<%= row.isActive ? 'false' : 'true' %>" />
                <button class="btn" type="submit"><%= row.isActive ? 'Deactivate' : 'Activate' %></button>
              </form>
            <% } else { %><span class="muted">Current account</span><% } %>
          </div></td>
        </tr>
      <% }) %>
    </tbody></table></div>
    <% if (pagination && pagination.pages > 1) { %>
      <div class="pager">
        <span class="muted"><%= pagination.total %> users • Page <%= pagination.page %> of <%= pagination.pages %></span>
        <div class="pager-actions">
          <% if (pagination.page > 1) { %><a class="btn" href="?page=<%= pagination.page - 1 %>">Previous</a><% } %>
          <% if (pagination.page < pagination.pages) { %><a class="btn" href="?page=<%= pagination.page + 1 %>">Next</a><% } %>
        </div>
      </div>
    <% } %>
  </main>
</body>
</html>
