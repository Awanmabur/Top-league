<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
  <title>Record Payment — Classic Academy</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
  <link rel="stylesheet" href="/css/navbar.css" />
  <style nonce="<%= cspNonce %>">
    body{margin:0;background:#f5f8ff;font-family:Poppins,Segoe UI,Arial,sans-serif;color:#0f172a;overflow-x:hidden}*{box-sizing:border-box;min-width:0}.main{flex:1;padding:20px 26px;display:flex;flex-direction:column;gap:16px}.title{font-size:20px;font-weight:700;color:#083454}.subtitle{font-size:13px;color:#6b7280;line-height:1.5}.card{background:#fff;border-radius:12px;padding:16px;border:1px solid #e4ecfb;box-shadow:0 6px 18px rgba(12,38,73,.04)}.form-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}.form-group{display:flex;flex-direction:column;gap:7px}.full{grid-column:1/-1}label{font-size:13px;font-weight:700;color:#334155}input,select,textarea{width:100%;border:1px solid #dbe3f6;border-radius:10px;padding:11px 12px;background:#fff;font:inherit}textarea{min-height:100px}.btn{padding:10px 14px;border-radius:10px;border:1px solid #dbe3f6;background:#eef4ff;color:#0a3d62;text-decoration:none;font-weight:700;display:inline-flex;align-items:center;gap:8px;cursor:pointer}.btn.primary{background:#0a3d62;color:#fff;border-color:#0a3d62}.alert{padding:12px 14px;border-radius:10px;background:#fff1f2;color:#991b1b;border:1px solid #fecdd3}.tip{font-size:12px;color:#64748b;line-height:1.6}@media (max-width:900px){.form-grid{grid-template-columns:1fr}.main{padding:16px}}
  </style>
</head>
<body>
  <%- include("./navbar") %>
  <main class="main">
    <div><div class="title">Record Platform Payment</div><div class="subtitle">Record a completed, externally confirmed payment against the school’s canonical current subscription. Pending provider events belong in the provider/reconciliation workflow, not this manual form.</div></div>
    <div class="card">
      <% if (error) { %><div class="alert" style="margin-bottom:14px;"><%= error %></div><% } %>
      <form action="/super-admin/billing/payments/create" method="POST" class="form-grid">
        <input type="hidden" name="_csrf" value="<%= csrfToken || '' %>" />
        <input type="hidden" name="subscriptionId" id="subscriptionId" value="<%= old?.subscriptionId || '' %>" />
        <input type="hidden" name="subscriptionRevision" id="subscriptionRevision" value="<%= old?.subscriptionRevision || '' %>" />
        <div class="form-group full">
          <label>School / Current Subscription</label>
          <select name="tenantId" id="tenantId" required>
            <option value="">Select school</option>
            <% (subscriptions || []).forEach(function(subscription){ const tenant = subscription.tenantId || {}; %>
              <option value="<%= tenant._id %>" data-subscription-id="<%= subscription._id %>" data-subscription-revision="<%= subscription.revision || 1 %>" data-billing-interval="<%= subscription.planSnapshot?.billingInterval || '' %>" <%= String(old?.tenantId || '') === String(tenant._id) ? 'selected' : '' %>><%= tenant.name || 'Unknown school' %> — <%= subscription.planSnapshot?.name || subscription.planId?.name || 'Plan' %> (<%= subscription.status %>, rev <%= subscription.revision || 1 %>)</option>
            <% }) %>
          </select>
          <div class="tip">The plan and revision are bound to the subscription shown here. If it changes before submit, the payment is rejected instead of silently rebasing.</div>
        </div>
        <div class="form-group"><label>Payment Type</label><select name="type" required>
          <% [['school_subscription','School Subscription'],['student_subscription','Student Subscription'],['revenue_split','Revenue Split'],['manual_adjust','Manual Adjustment'],['refund','Refund'],['credit','Credit']].forEach(function(item){ %>
            <option value="<%= item[0] %>" <%= old?.type === item[0] ? 'selected' : '' %>><%= item[1] %></option>
          <% }) %>
        </select></div>
        <div class="form-group"><label>Amount</label><input type="number" min="0.01" step="0.01" name="amount" value="<%= old?.amount || '' %>" required /></div>
        <div class="form-group"><label>Currency</label><input type="text" name="currency" value="<%= old?.currency || 'USD' %>" required /></div>
        <div class="form-group"><label>Provider</label><select name="provider">
          <% ['manual','bank','mtn','airtel','stripe','flutterwave','pesapal','other'].forEach(function(provider){ %><option value="<%= provider %>" <%= (old?.provider || 'manual')===provider?'selected':'' %>><%= provider.toUpperCase() %></option><% }) %>
        </select></div>
        <div class="form-group full"><label>Provider / Bank Reference</label><input type="text" name="reference" maxlength="120" value="<%= old?.reference || '' %>" required /><div class="tip">Provider + reference is unique and is used for idempotency.</div></div>
        <div class="form-group"><label>Period Start</label><input type="date" id="periodStart" name="periodStart" value="<%= old?.periodStart || '' %>" /><div class="tip">For fixed billing intervals the server derives this from the current paid-through date.</div></div>
        <div class="form-group"><label>Period End</label><input type="date" id="periodEnd" name="periodEnd" value="<%= old?.periodEnd || '' %>" /><div class="tip">Required only for custom billing intervals. Fixed intervals are calculated from the frozen plan.</div></div>
        <div class="form-group full"><label>Paid At</label><input type="datetime-local" name="paidAt" value="<%= old?.paidAt || '' %>" /></div>
        <div class="form-group full"><label>Notes</label><textarea name="notes"><%= old?.notes || '' %></textarea></div>
        <div class="form-group full"><button type="submit" class="btn primary">Record Completed Payment</button></div>
      </form>
    </div>
  </main>
  <script nonce="<%= cspNonce %>">
    (function(){
      const select = document.getElementById('tenantId');
      const subId = document.getElementById('subscriptionId');
      const subRevision = document.getElementById('subscriptionRevision');
      const periodStart = document.getElementById('periodStart');
      const periodEnd = document.getElementById('periodEnd');
      function syncSubscriptionClaim(){
        const option = select?.selectedOptions?.[0];
        if (!option) return;
        subId.value = option.dataset.subscriptionId || '';
        subRevision.value = option.dataset.subscriptionRevision || '';
        const custom = option.dataset.billingInterval === 'custom';
        periodStart.disabled = !custom;
        periodEnd.disabled = !custom;
        if (!custom) { periodStart.value = ''; periodEnd.value = ''; }
      }
      select?.addEventListener('change', syncSubscriptionClaim);
      syncSubscriptionClaim();
    })();
  </script>
  <script src="/js/navbar.js"></script>
</body>
</html>
