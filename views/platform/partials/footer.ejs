<style nonce="<%= cspNonce %>">
    /* Canonical footer contract: computed visual behavior of the approved main page. */
    .footer {
      background-color: #f9f9f9;
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      font-size: 0.95rem;
      line-height: 1.6;
      color: #333;
      background: rgba(255, 255, 255, 0.3);
      backdrop-filter: blur(10px);
      border-radius: 25px;
      margin: 2rem var(--page-pad);
      padding: 0;
      box-shadow: 0 8px 32px rgba(0, 0, 0, 0.1);
      gap: 0;
    }

    .footer div {
      margin: 1rem;
      padding: 0;
      flex: 1 1 220px;
      min-width: 220px;
    }

    .footer h4 {
      font-size: 1rem;
      line-height: 1.6;
      margin: 0 0 1rem;
      padding: 0;
      color: inherit;
    }

    .footer p {
      margin: 0;
      padding: 0;
      color: inherit;
    }

    .footer ul {
      list-style: none;
      margin: 0;
      padding: 0;
    }

    .footer ul li {
      margin: 0 0 0.5rem;
      padding: 0;
    }

    .footer a {
      text-decoration: none;
    }

    .footer ul li a {
      color: #333;
    }

    .footer ul li a:hover {
      text-decoration: underline;
    }

    @media (max-width: 600px) {
      .footer {
        backdrop-filter: none !important;
      }
    }

    @media (max-width: 480px) {
      .footer h4 {
        font-size: 1.15rem;
      }
    }
</style>

