<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title><%= letter.type %> — <%= tenant?.name || 'Classic Academy' %></title>
  <style>
    body{font-family:Arial,sans-serif;color:#111;margin:0;background:#fff}.page{max-width:820px;margin:0 auto;padding:44px}.head{text-align:center;border-bottom:2px solid #111;padding-bottom:16px}.school{font-size:24px;font-weight:800}.meta{font-size:13px;color:#444}.body{font-size:16px;line-height:1.7;margin-top:38px}.verify{margin-top:46px;border-top:1px solid #aaa;padding-top:18px;display:flex;gap:18px;align-items:center}.verify img{width:120px;height:120px}.mono{font-family:monospace;word-break:break-all;font-size:11px}.actions{max-width:820px;margin:16px auto;text-align:right}@media print{.actions{display:none}.page{padding:20px}}
  </style>
</head>
<body>
<div class="actions"><button onclick="window.print()">Print / Save PDF</button></div>
<main class="page">
  <header class="head">
    <div class="school"><%= tenant?.name || 'Classic Academy' %></div>
    <div class="meta"><%= tenant?.email || '' %> <%= tenant?.phone ? ' • ' + tenant.phone : '' %></div>
  </header>
  <section class="body">
    <p><strong>Reference:</strong> <%= letter.requestNumber %></p>
    <p><strong>Date:</strong> <%= new Date(letter.readyAt || letter.updatedAt || Date.now()).toDateString() %></p>
    <p><strong>RE: <%= letter.type.toUpperCase() %></strong></p>
    <p>To whom it may concern,</p>
    <% if (letter.type === 'Admission Letter') { %>
      <p>This letter confirms that <strong><%= studentName %></strong> is recorded by <%= tenant?.name || 'Classic Academy' %> as a student for academic year <strong><%= letter.issuedSnapshot?.academicYear || letter.academicYear %></strong>, term <strong><%= letter.issuedSnapshot?.term || letter.term %></strong>.</p>
    <% } else if (letter.type === 'Study Load Confirmation') { %>
      <p>This is to confirm that <strong><%= studentName %></strong> is currently registered for academic study at <%= tenant?.name || 'Classic Academy' %> for academic year <strong><%= letter.issuedSnapshot?.academicYear || letter.academicYear %></strong>, term <strong><%= letter.issuedSnapshot?.term || letter.term %></strong>.</p>
    <% } else { %>
      <p>This is to certify that <strong><%= studentName %></strong> is a duly recorded student of <%= tenant?.name || 'Classic Academy' %> for academic year <strong><%= letter.issuedSnapshot?.academicYear || letter.academicYear %></strong>, term <strong><%= letter.issuedSnapshot?.term || letter.term %></strong>.</p>
    <% } %>
    <% if (letter.issuedSnapshot?.purpose || letter.purpose) { %><p>This letter was requested for: <%= letter.issuedSnapshot?.purpose || letter.purpose %>.</p><% } %>
    <p>Issued by the Registry Office.</p>
  </section>
  <section class="verify">
    <img src="<%= qrDataUrl %>" alt="Verification QR code">
    <div><strong>Digitally verifiable document</strong><div class="meta">Scan the QR code or use the verification address below.</div><div class="mono"><%= verifyUrl %></div></div>
  </section>
</main>
</body>
</html>
