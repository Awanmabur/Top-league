<!DOCTYPE html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>My Transport - <%= tenant?.name || 'Classic Academy' %></title><link rel="stylesheet" href="/css/student-portal.css"><link rel="stylesheet" href="/css/navbar.css"></head><body data-portal="student"><%- include('./navbar') %><main class="main"><div class="topbar"><div><div class="title">My Transport</div><div class="subtitle">Your current school transport route and pickup point.</div></div><a class="btn light" href="/student/dashboard">Dashboard</a></div><section class="card"><% if (!assignment) { %><div class="section-title">No active transport assignment</div><p class="muted">Contact the school office if you need transport.</p><% } else { const r=assignment.route; %><div class="section-title"><%= r.routeName %> <span class="muted">(<%= r.routeCode %>)</span></div><div class="kpi-row"><div class="card"><div class="section-title">Pickup</div><div><%= assignment.pickupPoint %></div></div><div class="card"><div class="section-title">Vehicle</div><div><%= r.vehicleName || '—' %></div><div class="muted"><%= r.vehicleRegNo || '' %></div></div><div class="card"><div class="section-title">Driver</div><div><%= r.driverName || '—' %></div><div class="muted"><%= r.driverPhone || '' %></div></div><div class="card"><div class="section-title">Transport Fee</div><div><%= Number(assignment.feeAmountSnapshot || 0).toLocaleString() %></div></div></div><% if (r.notes) { %><div class="card"><div class="section-title">Route Note</div><div><%= r.notes %></div></div><% } %><% } %></section></main><script src="/js/navbar.js"></script></body></html>
