<!DOCTYPE html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>My School Assets - <%= tenant?.name || 'Classic Academy' %></title><link rel="stylesheet" href="/css/student-portal.css"><link rel="stylesheet" href="/css/navbar.css"></head><body data-portal="student"><%- include('./navbar') %><main class="main"><div class="topbar"><div><div class="title">My School Assets</div><div class="subtitle">Equipment currently issued to you.</div></div><a class="btn light" href="/student/dashboard">Dashboard</a></div><section class="card"><% if(!items.length){ %><div class="muted">No school assets are currently assigned to you.</div><% } %><% items.forEach(function(x){ %><div class="card"><div class="section-title"><%= x.assetTag %> — <%= x.name %></div><div class="muted"><%= x.category %> · <%= x.condition %> · Qty <%= x.quantity %></div><div>Assigned: <%= x.assignedAt ? new Date(x.assignedAt).toISOString().slice(0,10) : '—' %></div><div>Due: <%= x.dueBackAt ? new Date(x.dueBackAt).toISOString().slice(0,10) : 'No due date' %></div></div><% }) %></section></main><script src="/js/navbar.js"></script></body></html>
