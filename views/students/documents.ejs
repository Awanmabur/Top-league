<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <title>My Documents — <%= tenant?.name || "Classic Academy" %></title>
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" crossorigin="anonymous" referrerpolicy="no-referrer" />
  <link rel="stylesheet" href="/css/navbar.css" />
  <link rel="stylesheet" href="/css/student-portal.css" />
</head>
<body data-portal="student">
<%- include("./navbar") %>
<main class="main">
  <div class="topbar"><div><div class="title">My Documents</div><div class="subtitle">School records that have been shared with your account.</div></div></div>
  <section class="card">
    <div class="section-title">Available documents</div>
    <div class="notif-list" style="margin-top:12px;">
      <% if (documents?.length) { documents.forEach(function(doc) { %>
        <div class="notif-item">
          <div class="notif-icon"><i class="fa-solid fa-file-shield"></i></div>
          <div style="min-width:0;flex:1;">
            <div class="notif-title"><%= doc.title %></div>
            <div class="notif-meta"><%= doc.type %> • <%= doc.effectiveStatus %><%= doc.expiryDate ? " • expires " + new Date(doc.expiryDate).toISOString().slice(0,10) : "" %></div>
          </div>
          <a class="btn light" href="<%= doc.downloadUrl %>"><i class="fa-solid fa-download"></i> Open</a>
        </div>
      <% }); } else { %><div class="small-muted">No student documents have been shared with you.</div><% } %>
    </div>
  </section>
</main></div>
<script src="/js/navbar.js"></script>
</body></html>
