<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <title><%= pageTitle %> — <%= tenant?.name || "Classic Academy" %></title>
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" crossorigin="anonymous" referrerpolicy="no-referrer" />
  <link rel="stylesheet" href="/css/navbar.css"/>
  <link rel="stylesheet" href="/css/student-portal.css" />
</head>
<body data-portal="student">
<%- include("./navbar") %>

<main class="main">
  <div class="topbar">
    <div>
      <div class="title">Transcripts & Official Letters</div>
      <div class="subtitle">
        View your published marks, term averages, grades, official transcript, and school letters.
      </div>
    </div>
    <div class="top-actions">
      <a class="btn light" href="/student/dashboard">
        <i class="fa-solid fa-arrow-left"></i> Back to Dashboard
      </a>
      <% if (officialTranscript) { %>
        <a class="btn primary" href="/student/transcript/<%= officialTranscript.id %>/print" target="_blank">
          <i class="fa-solid fa-file-shield"></i> Open Official Transcript
        </a>
      <% } else { %>
        <button class="btn primary" type="button" data-print>
          <i class="fa-solid fa-print"></i> Print Published Results
        </button>
      <% } %>
    </div>
  </div>

  <%-include("../tenant/partials/flash") %>

  <section class="card">
    <div class="section-title">Academic record</div>
    <div class="section-sub">This view contains published Results only. Draft or quarantined marks are never shown here.</div>

    <div class="filters-row" style="margin-top:10px;">
      <div>
        <label class="small-muted">Class / Level</label><br/>
        <select class="select"><option selected><%= meta.level %></option></select>
      </div>
      <div>
        <label class="small-muted">Academic year</label><br/>
        <select class="select"><option selected><%= overview.latestAcademicYear || meta.academicYear %></option></select>
      </div>
      <div>
        <label class="small-muted">Latest term</label><br/>
        <select class="select"><option selected><%= overview.latestTerm ? ('Term ' + overview.latestTerm) : '—' %></option></select>
      </div>
      <div>
        <label class="small-muted">Format</label><br/>
        <select class="select"><option selected>Published results</option></select>
      </div>
    </div>
  </section>

  <% if (officialTranscript) { %>
    <section class="card" style="margin-top:12px;">
      <div class="section-title">Official transcript available</div>
      <div class="section-sub">Issue <strong><%= officialTranscript.issueNumber %></strong> • Issued <%= officialTranscript.issuedAt ? new Date(officialTranscript.issuedAt).toDateString() : '—' %>. The issued snapshot is immutable and QR-verifiable.</div>
    </section>
  <% } %>

  <div class="kpi-row">
    <div class="card" style="flex:1;">
      <div class="section-title">Overall average</div>
      <div class="section-sub">Across published results</div>
      <div style="margin-top:8px;"><div style="font-size:22px;font-weight:700;"><%= overview.average %>%</div><div class="small-muted">Grade: <strong><%= overview.overallGrade %></strong> • <%= overview.overallRemark %></div></div>
    </div>
    <div class="card" style="flex:1;">
      <div class="section-title">Latest term average</div>
      <div class="section-sub"><%= overview.latestAcademicYear || 'Current record' %><%= overview.latestTerm ? (' • Term ' + overview.latestTerm) : '' %></div>
      <div style="margin-top:8px;"><div style="font-size:22px;font-weight:700;"><%= overview.latestTermAverage %>%</div></div>
    </div>
    <div class="card" style="flex:1;">
      <div class="section-title">Subjects passed</div>
      <div class="section-sub">Based on each exam pass threshold</div>
      <div style="margin-top:8px;"><div style="font-size:22px;font-weight:700;"><%= overview.passed %> / <%= overview.totalSubjects %></div><div class="small-muted"><%= overview.failed %> below pass threshold</div></div>
    </div>
    <div class="card" style="flex:1;">
      <div class="section-title">Academic status</div>
      <div class="section-sub">Current account standing</div>
      <div style="margin-top:8px;"><div class="pill-status"><i class="fa-solid fa-circle-check"></i> <%= overview.academicStatus %></div></div>
    </div>
  </div>
  <div class="content">
    <section class="card">
      <div class="section-title">Academic transcript</div>
      <div class="section-sub">Published transcript rows.</div>

      <div style="margin-top:10px;overflow-x:auto;">
        <table style="width:100%;border-collapse:collapse;font-size:13px;">
          <thead>
            <tr style="border-bottom:1px solid #e5edff;">
              <th style="text-align:left;padding:6px 4px;">Academic year</th>
              <th style="text-align:center;padding:6px 4px;">Term</th>
              <th style="text-align:left;padding:6px 4px;">Subject</th>
              <th style="text-align:left;padding:6px 4px;">Exam</th>
              <th style="text-align:center;padding:6px 4px;">Marks</th>
              <th style="text-align:center;padding:6px 4px;">Percentage</th>
              <th style="text-align:center;padding:6px 4px;">Grade</th>
              <th style="text-align:left;padding:6px 4px;">Remark</th>
            </tr>
          </thead>
          <tbody>
            <% if (transcriptRows?.length) { %>
              <% transcriptRows.forEach(function(row){ %>
                <tr>
                  <td><%= row.academicYear || '—' %></td>
                  <td style="text-align:center;">Term <%= row.term %></td>
                  <td><%= row.subjectCode ? (row.subjectCode + ' — ') : '' %><%= row.subjectTitle %></td>
                  <td><%= row.examTitle %></td>
                  <td style="text-align:center;"><%= row.rawScore %> / <%= row.totalMarks %></td>
                  <td style="text-align:center;"><%= row.percentage %>%</td>
                  <td style="text-align:center;"><%= row.grade %></td>
                  <td><%= row.remark %></td>
                </tr>
              <% }) %>
            <% } else { %>
              <tr><td colspan="8">No published results found.</td></tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </section>

    <aside>
      <section class="card">
        <div class="section-title">Academic summary</div>
        <div class="section-sub">Key indicators from your academic record.</div>

        <div class="mini-list" style="margin-top:8px;">
          <div class="mini-item"><span>Class / Level</span><span><%= meta.level %></span></div>
          <div class="mini-item"><span>Student ID</span><span><%= meta.studentNumber %></span></div>
          <div class="mini-item"><span>Latest term</span><span><%= overview.latestTerm ? ('Term ' + overview.latestTerm) : '—' %></span></div>
          <div class="mini-item"><span>Academic year</span><span><%= meta.academicYear %></span></div>
        </div>
      </section>

      <section class="card" style="margin-top:16px;">
        <div class="section-title">Transcript notes</div>
        <div class="section-sub">Important information about official transcripts.</div>

        <ul class="mini-list" style="margin-top:8px;">
          <li class="mini-item"><span>Unofficial copy</span><span>For personal use only</span></li>
          <li class="mini-item"><span>Official transcript</span><span>Issued by Registry Office</span></li>
          <li class="mini-item"><span>Processing time</span><span>2–5 working days</span></li>
          <li class="mini-item"><span>Outstanding fees</span><span>May delay official release</span></li>
        </ul>
      </section>
    </aside>
  </div>

  <div class="content" style="margin-top:16px;">
    <section class="card">
      <div class="section-title">Official letters</div>
      <div class="section-sub">Request and track official letters. Only Registry can approve and release them.</div>
      <div style="margin-top:10px;overflow-x:auto;">
        <table style="width:100%;border-collapse:collapse;font-size:13px;">
          <thead><tr style="border-bottom:1px solid #e5edff;"><th style="text-align:left;padding:6px 4px;">Letter</th><th style="text-align:left;padding:6px 4px;">Purpose</th><th style="text-align:left;padding:6px 4px;">Status</th><th style="text-align:left;padding:6px 4px;">Action</th></tr></thead>
          <tbody>
            <% if (lettersCatalogue?.length) { lettersCatalogue.forEach(function(letter){ %>
              <tr style="border-bottom:1px solid #eef3ff;">
                <td style="padding:8px 4px;"><strong><%= letter.type %></strong><div class="small-muted"><%= letter.format %></div></td>
                <td style="padding:8px 4px;"><%= letter.purpose %></td>
                <td style="padding:8px 4px;"><%= letter.request?.status || 'Not requested' %><% if (letter.request?.requestedAt) { %><div class="small-muted"><%= new Date(letter.request.requestedAt).toDateString() %></div><% } %></td>
                <td style="padding:8px 4px;">
                  <% if (!letter.request || ['Rejected','Cancelled'].includes(letter.request.status)) { %>
                    <form method="post" action="/student/letters/request">
                      <input type="hidden" name="_csrf" value="<%= csrfToken || '' %>"><input type="hidden" name="type" value="<%= letter.type %>">
                      <input type="text" name="purpose" maxlength="1000" placeholder="Optional purpose" style="max-width:220px;"> <button class="btn primary" type="submit">Request</button>
                    </form>
                  <% } else if (letter.request.canOpen) { %>
                    <a class="btn primary" href="/student/letters/<%= letter.request.id %>/print" target="_blank" rel="noopener">Open letter</a>
                  <% } else if (letter.request.canCancel) { %>
                    <form method="post" action="/student/letters/<%= letter.request.id %>/cancel"><input type="hidden" name="_csrf" value="<%= csrfToken || '' %>"><button class="btn" type="submit">Cancel request</button></form>
                  <% } else { %><span class="small-muted">Registry processing</span><% } %>
                </td>
              </tr>
            <% }); } else { %><tr><td colspan="4">No letter options available.</td></tr><% } %>
          </tbody>
        </table>
      </div>
    </section>
    <section class="card">
      <div class="section-title">Letter history</div><div class="section-sub">Current request limits and status.</div>
      <div class="mini-list" style="margin-top:8px;"><div class="mini-item"><span>Letters requested this academic year</span><span><%= lettersStats.requestedThisYear %></span></div><div class="mini-item"><span>Pending letters</span><span><%= lettersStats.pending %></span></div><div class="mini-item"><span>Maximum online requests per term</span><span><%= lettersStats.maxPerTerm %></span></div></div>
    </section>
  </div>
</main>
</div>

<script src="/js/navbar.js"></script>
</body>
</html>
