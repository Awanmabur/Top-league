<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <title><%= pageTitle %> — <%= tenant?.name || "Classic Academy" %></title>
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" crossorigin="anonymous" referrerpolicy="no-referrer" />
  <link rel="stylesheet" href="/css/navbar.css"/>
  <link rel="stylesheet" href="/css/student-portal.css" />
  <style>
    .reg-status-pill{display:inline-flex;align-items:center;gap:6px;padding:4px 9px;border-radius:999px;font-size:12px;background:#ecfdf3;color:#15803d}
    .reg-status-pill.warn{background:#fef9c3;color:#92400e}.reg-status-pill.danger{background:#fee2e2;color:#b91c1c}
  </style>
</head>
<body data-portal="student">
<%- include("./navbar") %>
<main class="main">
  <div class="topbar">
    <div><div class="title">Subject Selection</div><div class="subtitle">Choose optional subjects during the active registration window. Compulsory subjects are assigned automatically.</div></div>
    <div class="top-actions"><a class="btn light" href="/student/dashboard"><i class="fa-solid fa-arrow-left"></i> Back to Dashboard</a></div>
  </div>
  <%-include("../tenant/partials/flash") %>

  <section class="card">
    <div style="display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap;align-items:flex-start;">
      <div>
        <div class="section-title">Registration status</div>
        <div class="section-sub"><%= meta.academicYear %> • Term <%= student?.term || '—' %> • <%= meta.program %></div>
        <div style="margin-top:8px;display:flex;flex-wrap:wrap;gap:8px;">
          <% if (windowInfo) { %><span class="reg-status-pill"><i class="fa-solid fa-circle-check"></i> Window open until <%= new Date(windowInfo.closesAt).toDateString() %></span>
          <% } else { %><span class="reg-status-pill warn"><i class="fa-solid fa-clock"></i> Registration closed</span><% } %>
          <% if (holds?.length) { %><span class="reg-status-pill danger"><i class="fa-solid fa-triangle-exclamation"></i> <%= holds.length %> blocking hold(s)</span><% } %>
        </div>
        <% if (holds?.length) { %><div class="small-muted" style="margin-top:8px;"><%= holds.map(h => h.reason || 'Student hold').join(' • ') %></div><% } %>
      </div>
      <div class="kpi-row" style="grid-template-columns:repeat(3,minmax(0,1fr));flex:1;min-width:260px;">
        <div class="kpi-card"><div class="kpi-top"><div><div class="kpi-label">Compulsory</div><div class="kpi-value"><%= totals.compulsory %></div></div><i class="fa-solid fa-book"></i></div></div>
        <div class="kpi-card"><div class="kpi-top"><div><div class="kpi-label">Optional selected</div><div class="kpi-value"><%= totals.optionalSelected %></div></div><i class="fa-solid fa-list-check"></i></div><div class="kpi-footer"><%= totals.maxOptional ? ('Maximum ' + totals.maxOptional) : 'No optional cap configured' %></div></div>
        <div class="kpi-card"><div class="kpi-top"><div><div class="kpi-label">Holds</div><div class="kpi-value"><%= totals.holds %></div></div><i class="fa-solid fa-lock"></i></div></div>
      </div>
    </div>
  </section>

  <section class="card">
    <div class="section-title">Current subjects</div><div class="section-sub">Compulsory subjects and your active optional selections.</div>
    <div style="margin-top:10px;overflow-x:auto;"><table style="width:100%;border-collapse:collapse;font-size:13px;">
      <thead><tr style="border-bottom:1px solid #e5edff;"><th style="text-align:left;padding:6px 4px;">Code</th><th style="text-align:left;padding:6px 4px;">Title</th><th>Periods / week</th><th>Status</th><th>Action</th></tr></thead>
      <tbody>
        <% if (registeredSubjects?.length) { registeredSubjects.forEach(function(c){ %>
          <tr><td><%= c.subjectCode %></td><td><%= c.subjectTitle %></td><td style="text-align:center"><%= c.weeklyPeriods %></td><td><%= c.status %></td><td>
            <% if (c.canDrop) { %><form method="POST" action="/student/subject-selection/<%= c.id %>/drop" style="display:inline"><input type="hidden" name="_csrf" value="<%= csrfToken || '' %>"><button class="btn-xs" type="submit"><i class="fa-solid fa-minus"></i> Drop</button></form><% } else { %>—<% } %>
          </td></tr>
        <% }) } else { %><tr><td colspan="5">No current subjects found.</td></tr><% } %>
      </tbody>
    </table></div>
  </section>

  <section class="card">
    <div class="section-title">Subject catalogue</div><div class="section-sub">Only subjects scoped to your current class, section, stream, academic year and term are shown.</div>
    <div style="margin-top:10px;overflow-x:auto;"><table style="width:100%;border-collapse:collapse;font-size:13px;">
      <thead><tr style="border-bottom:1px solid #e5edff;"><th style="text-align:left;padding:6px 4px;">Code</th><th style="text-align:left;padding:6px 4px;">Title</th><th>Periods / week</th><th>Type</th><th>Status</th><th>Action</th></tr></thead>
      <tbody>
        <% if (catalogue?.length) { catalogue.forEach(function(c){ %>
          <tr><td><%= c.subjectCode %></td><td><%= c.subjectTitle %></td><td style="text-align:center"><%= c.weeklyPeriods %></td><td><%= c.isCompulsory ? 'Compulsory' : 'Optional' %></td><td><%= c.regStatus %></td><td>
            <% if (c.canAdd) { %><form method="POST" action="/student/subject-selection/<%= c.id %>/add" style="display:inline"><input type="hidden" name="_csrf" value="<%= csrfToken || '' %>"><button class="btn-xs" type="submit"><i class="fa-solid fa-plus"></i> Add</button></form>
            <% } else if (c.canDrop && c.registrationId) { %><form method="POST" action="/student/subject-selection/<%= c.registrationId %>/drop" style="display:inline"><input type="hidden" name="_csrf" value="<%= csrfToken || '' %>"><button class="btn-xs" type="submit"><i class="fa-solid fa-minus"></i> Drop</button></form>
            <% } else { %>—<% } %>
          </td></tr>
        <% }) } else { %><tr><td colspan="6">No subjects are available for your current scope.</td></tr><% } %>
      </tbody>
    </table></div>
  </section>
</main>
<script src="/js/navbar.js"></script>
</body>
</html>
