<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <title><%= pageTitle %> — <%= tenant?.name || "Classic Academy" %></title>
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" crossorigin="anonymous" referrerpolicy="no-referrer" />
  <link rel="stylesheet" href="/css/navbar.css"/>
  <link rel="stylesheet" href="/css/student-portal.css" />
  <style nonce="<%= cspNonce %>">
    .status{display:inline-flex;padding:5px 9px;border-radius:999px;font-size:12px;font-weight:800;background:#eef2ff;color:#3730a3}.status.graded{background:#ecfdf3;color:#166534}.status.submitted{background:#eff6ff;color:#1d4ed8}.status.late{background:#fff7ed;color:#9a3412}
    .assignment-title{font-weight:900;color:#0f172a}.assignment-meta{font-size:12px;color:#64748b;margin-top:3px}.action-link{display:inline-flex;align-items:center;gap:6px;text-decoration:none;font-weight:800}
  </style>
</head>
<body data-portal="student">
<%- include("./navbar") %>
<main class="main">
  <div class="topbar"><div><div class="title">Assignments</div><div class="subtitle">Coursework assigned to your current class, section, stream and term.</div></div></div>
  <%-include("../tenant/partials/flash") %>
  <div class="kpi-row">
    <div class="card"><div class="section-title">Total</div><div style="font-size:22px;font-weight:800;"><%= kpis.total %></div></div>
    <div class="card"><div class="section-title">Due Soon</div><div style="font-size:22px;font-weight:800;"><%= kpis.dueSoon %></div></div>
    <div class="card"><div class="section-title">Open</div><div style="font-size:22px;font-weight:800;"><%= kpis.open %></div></div>
    <div class="card"><div class="section-title">Submitted / Graded</div><div style="font-size:22px;font-weight:800;"><%= kpis.submitted %> / <%= kpis.graded %></div></div>
  </div>
  <section class="card" style="margin-top:16px;">
    <div class="section-title">Assignment list</div><div class="section-sub">Only published or closed coursework in your canonical academic scope is shown.</div>
    <div style="overflow-x:auto;margin-top:12px;">
      <table style="width:100%;border-collapse:collapse;font-size:13px;min-width:900px;">
        <thead><tr style="border-bottom:1px solid #e5edff;"><th style="text-align:left;padding:8px 6px;">Assignment</th><th style="text-align:left;padding:8px 6px;">Subject</th><th style="text-align:left;padding:8px 6px;">Due</th><th style="text-align:left;padding:8px 6px;">Points</th><th style="text-align:left;padding:8px 6px;">Submission</th><th style="text-align:left;padding:8px 6px;">Score</th><th style="text-align:left;padding:8px 6px;">Action</th></tr></thead>
        <tbody>
        <% if (assignments?.length) { assignments.forEach(function(a){ %>
          <tr style="border-bottom:1px solid #eef2f7;">
            <td style="padding:10px 6px;"><div class="assignment-title"><%= a.title %></div><div class="assignment-meta">Term <%= a.term %> • <%= a.academicYear || 'Academic year not set' %> • <%= a.assignmentStatus %></div></td>
            <td style="padding:10px 6px;"><%= a.courseCode ? a.courseCode + ' — ' : '' %><%= a.courseTitle %></td>
            <td style="padding:10px 6px;"><%= a.dueDisplay || 'No deadline' %><% if (a.overdue) { %><div><span class="status late">Past deadline</span></div><% } %></td>
            <td style="padding:10px 6px;"><%= a.totalPoints %></td>
            <td style="padding:10px 6px;"><span class="status <%= a.submissionStatus %>"><%= String(a.submissionStatus || 'not_submitted').replaceAll('_',' ') %></span><% if (a.isLate) { %> <span class="status late">Late</span><% } %></td>
            <td style="padding:10px 6px;"><%= a.score === null ? '—' : `${a.score}/${a.totalPoints} (${a.percentage}%)` %></td>
            <td style="padding:10px 6px;"><a class="action-link" href="/student/assignments/<%= a.id %>"><i class="fa-solid fa-arrow-up-right-from-square"></i> Open</a></td>
          </tr>
        <% }) } else { %><tr><td colspan="7" style="padding:16px 6px;">No assignments are currently assigned to your academic scope.</td></tr><% } %>
        </tbody>
      </table>
    </div>
  </section>
</main>
<script src="/js/navbar.js"></script>
</body>
</html>
