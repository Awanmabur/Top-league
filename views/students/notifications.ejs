<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <title><%= pageTitle %> — <%= tenant?.name || "Classic Academy" %></title>
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" crossorigin="anonymous" referrerpolicy="no-referrer" />
  <link rel="stylesheet" href="/css/navbar.css"/>
  <link rel="stylesheet" href="/css/student-portal.css" />
</head>
<body data-portal="student">
<%- include("./navbar") %>

<main class="main">
  <div class="topbar">
    <div>
      <div class="title">Notifications</div>
      <div class="subtitle">Your alerts, system messages, and announcements.</div>
    </div>
    <form method="POST" action="/student/notifications/read-all">
      <% if (csrfToken) { %><input type="hidden" name="_csrf" value="<%= csrfToken %>"><% } %>
      <button class="btn light" type="submit"><i class="fa-solid fa-check-double"></i> Mark all read</button>
    </form>
  </div>

  <%-include("../tenant/partials/flash") %>
  
  <div class="kpi-row">
    <div class="card"><div class="section-title">Total</div><div style="font-size:22px;font-weight:800;"><%= stats.total %></div></div>
    <div class="card"><div class="section-title">Unread</div><div style="font-size:22px;font-weight:800;"><%= stats.unread %></div></div>
    <div class="card"><div class="section-title">Announcements</div><div style="font-size:22px;font-weight:800;"><%= stats.announcements %></div></div>
  </div>


  <section class="card" style="margin-top:16px;">
    <div class="section-title">Notification Preferences</div>
    <div class="section-sub">Choose optional in-app categories. Security and system notices always remain enabled.</div>
    <form method="POST" action="/student/notifications/preferences" style="display:grid;gap:10px;margin-top:12px;">
      <% if (csrfToken) { %><input type="hidden" name="_csrf" value="<%= csrfToken %>"><% } %>
      <label><input type="checkbox" name="inApp" <%= preference?.inApp !== false ? 'checked' : '' %>> In-app notifications</label>
      <div style="display:flex;gap:12px;flex-wrap:wrap;">
        <% (preferenceCategories || []).filter(function(c){ return c !== 'system'; }).forEach(function(category){ %>
          <label><input type="checkbox" name="<%= category %>" <%= preference?.[category] !== false ? 'checked' : '' %>> <%= category.replace(/_/g,' ').replace(/\b\w/g,function(x){return x.toUpperCase();}) %></label>
        <% }); %>
        <label><input type="checkbox" checked disabled> System (required)</label>
      </div>
      <div><button class="btn primary" type="submit"><i class="fa-solid fa-floppy-disk"></i> Save preferences</button></div>
    </form>
  </section>

  <section class="card" style="margin-top:16px;">
    <div class="section-title">Recent Notifications</div>
    <div class="section-sub">Latest activity in your student portal.</div>

    <div class="notif-list" style="margin-top:10px;">
      <% if (notifications?.length) { %>
        <% notifications.forEach(function(item){ %>
          <div class="notif-item">
            <div class="notif-icon">
              <i class="fa-solid <%= item.source === 'announcement' ? 'fa-bullhorn' : 'fa-bell' %>"></i>
            </div>
            <div>
              <div class="notif-title">
                <%= item.title %>
                <% if (!item.read) { %>
                  <span class="badge-mode" style="margin-left:8px;">New</span>
                <% } %>
              </div>
              <div class="notif-meta">
                <%= item.createdAt ? new Date(item.createdAt).toDateString() : "-" %> • <%= item.category %>
              </div>
              <div class="small-muted" style="margin-top:4px;"><%= item.message %></div>
              <% if (item.source === 'notification' && !item.read) { %>
                <form method="POST" action="/student/notifications/<%= item.id %>/read" style="margin-top:8px;">
                  <% if (csrfToken) { %><input type="hidden" name="_csrf" value="<%= csrfToken %>"><% } %>
                  <button class="btn-xs" type="submit"><i class="fa-solid fa-check"></i> Mark Read</button>
                </form>
              <% } %>
              <% if (item.source === 'announcement' && item.requiresAcknowledgement) { %>
                <form method="POST" action="/student/announcements/<%= item.id %>/ack" style="margin-top:8px;">
                  <% if (csrfToken) { %><input type="hidden" name="_csrf" value="<%= csrfToken %>"><% } %>
                  <button class="btn-xs" type="submit"><i class="fa-solid fa-user-check"></i> Acknowledge</button>
                </form>
              <% } %>
            </div>
          </div>
        <% }) %>
      <% } else { %>
        <div class="small-muted">No notifications found.</div>
      <% } %>
    </div>
  </section>
</main>
</div>
<script src="/js/navbar.js"></script>
</body>
</html>
