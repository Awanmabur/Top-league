<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <title>Discipline — <%= tenant?.name || "Classic Academy" %></title>
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" crossorigin="anonymous" referrerpolicy="no-referrer" />
  <link rel="stylesheet" href="/css/navbar.css" />
  <link rel="stylesheet" href="/css/student-portal.css" />
</head>
<body data-portal="student">
<%- include("./navbar") %>
<main class="main">
  <div class="topbar"><div><div class="title">Discipline</div><div class="subtitle">Only case information explicitly released to you by the school appears here.</div></div></div>
  <section class="card">
    <div class="section-title">Released cases</div>
    <div class="notif-list" style="margin-top:12px;">
      <% if (cases?.length) { cases.forEach(function(item) { %>
        <div class="notif-item">
          <div class="notif-icon"><i class="fa-solid fa-scale-balanced"></i></div>
          <div style="min-width:0;">
            <div class="notif-title"><%= item.caseNo %> • <%= item.category %></div>
            <div class="notif-meta"><%= item.incidentDate ? new Date(item.incidentDate).toISOString().slice(0,10) : "" %> • <%= item.status %></div>
            <div class="small-muted" style="margin-top:6px;"><%= item.description %></div>
            <% if (item.resolutionSummary) { %><div class="small-muted" style="margin-top:6px;"><strong>Resolution:</strong> <%= item.resolutionSummary %></div><% } %>
            <% if (item.actions?.length) { %><div style="margin-top:8px;"><strong>Actions</strong><% item.actions.forEach(function(action) { %><div class="small-muted"><%= action.date ? new Date(action.date).toISOString().slice(0,10) + " • " : "" %><%= action.action %><%= action.details ? " — " + action.details : "" %></div><% }); %></div><% } %>
          </div>
        </div>
      <% }); } else { %><div class="small-muted">No discipline case has been released to your portal.</div><% } %>
    </div>
  </section>
</main></div>
<script src="/js/navbar.js"></script>
</body></html>
