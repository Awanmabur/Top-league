<!DOCTYPE html>
<html lang="en"><head><meta charset="utf-8" /><title>Discipline — <%= tenant?.name || "Classic Academy" %></title><meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" crossorigin="anonymous" referrerpolicy="no-referrer" /><link rel="stylesheet" href="/css/navbar.css" /><link rel="stylesheet" href="/css/parent-portal.css" /></head>
<body data-portal="parent"><%- include("./navbar") %><main class="main">
<div class="topbar"><div><div class="title">Discipline</div><div class="subtitle">Only case summaries explicitly released to parents are shown.</div></div></div>
<% if (children?.length) { %><section class="card"><form method="get" action="/parent/discipline"><label for="disciplineChild"><strong>Child</strong></label><select id="disciplineChild" name="student"><% children.forEach(function(child){ %><option value="<%= child._id %>" <%= student && String(student._id)===String(child._id) ? "selected" : "" %>><%= child.fullName || [child.firstName,child.lastName].filter(Boolean).join(" ") || child.regNo %></option><% }); %></select> <button class="btn light" type="submit">View</button></form></section><% } %>
<section class="card"><div class="section-title"><%= student ? (student.fullName || student.regNo) : "Released cases" %></div><div class="notif-list" style="margin-top:12px;">
<% if(cases?.length){ cases.forEach(function(item){ %><div class="notif-item"><div class="notif-icon"><i class="fa-solid fa-scale-balanced"></i></div><div><div class="notif-title"><%= item.caseNo %> • <%= item.category %></div><div class="notif-meta"><%= item.incidentDate ? new Date(item.incidentDate).toISOString().slice(0,10) : "" %> • <%= item.status %></div><div class="small-muted"><%= item.description %></div><% if(item.resolutionSummary){ %><div class="small-muted"><strong>Resolution:</strong> <%= item.resolutionSummary %></div><% } %><% if(item.actions?.length){ %><div style="margin-top:8px;"><strong>Actions</strong><% item.actions.forEach(function(action){ %><div class="small-muted"><%= action.action %><%= action.details ? " — "+action.details : "" %></div><% }); %></div><% } %></div></div><% }); } else { %><div class="small-muted"><%= error || "No discipline case has been released to the parent portal." %></div><% } %>
</div></section></main></div><script src="/js/navbar.js"></script></body></html>
