<!DOCTYPE html>
<html lang="en"><head><meta charset="utf-8" /><title>Student Documents — <%= tenant?.name || "Classic Academy" %></title><meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" crossorigin="anonymous" referrerpolicy="no-referrer" /><link rel="stylesheet" href="/css/navbar.css" /><link rel="stylesheet" href="/css/parent-portal.css" /></head>
<body data-portal="parent"><%- include("./navbar") %><main class="main">
<div class="topbar"><div><div class="title">Student Documents</div><div class="subtitle">Documents the school has explicitly shared with your parent account.</div></div></div>
<% if(children?.length){ %><section class="card"><form method="get" action="/parent/documents"><label for="documentChild"><strong>Child</strong></label><select id="documentChild" name="student"><% children.forEach(function(child){ %><option value="<%= child._id %>" <%= student && String(student._id)===String(child._id) ? "selected" : "" %>><%= child.fullName || [child.firstName,child.lastName].filter(Boolean).join(" ") || child.regNo %></option><% }); %></select> <button class="btn light" type="submit">View</button></form></section><% } %>
<section class="card"><div class="section-title"><%= student ? (student.fullName || student.regNo) : "Documents" %></div><div class="notif-list" style="margin-top:12px;">
<% if(documents?.length){ documents.forEach(function(doc){ %><div class="notif-item"><div class="notif-icon"><i class="fa-solid fa-file-shield"></i></div><div style="min-width:0;flex:1;"><div class="notif-title"><%= doc.title %></div><div class="notif-meta"><%= doc.type %> • <%= doc.effectiveStatus %><%= doc.expiryDate ? " • expires "+new Date(doc.expiryDate).toISOString().slice(0,10) : "" %></div></div><a class="btn light" href="<%= doc.downloadUrl %>"><i class="fa-solid fa-download"></i> Open</a></div><% }); } else { %><div class="small-muted"><%= error || "No documents have been shared for this child." %></div><% } %>
</div></section></main></div><script src="/js/navbar.js"></script></body></html>
