<!DOCTYPE html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>School Assets - <%= tenant?.name || 'Classic Academy' %></title><link rel="stylesheet" href="/css/student-portal.css"><link rel="stylesheet" href="/css/navbar.css"></head><body data-portal="parent"><%- include('./navbar') %><main class="main"><div class="topbar"><div><div class="title">School Assets</div><div class="subtitle">Equipment currently issued to your child.</div></div></div><section class="card"><div class="actions"><% children.forEach(function(c){ %><a class="btn <%= student&&String(student._id)===String(c._id)?'primary':'light' %>" href="/parent/assets?student=<%= encodeURIComponent(String(c._id)) %>"><%= c.fullName || c.regNo %></a><% }) %></div></section><section class="card"><% if(!student){ %><div class="muted">No linked student found.</div><% } else if(!items.length){ %><div class="muted">No school assets are currently assigned to <%= student.fullName %>.</div><% } %><% items.forEach(function(x){ %><div class="card"><div class="section-title"><%= x.assetTag %> — <%= x.name %></div><div class="muted"><%= x.category %> · <%= x.condition %> · Qty <%= x.quantity %></div><div>Due: <%= x.dueBackAt ? new Date(x.dueBackAt).toISOString().slice(0,10) : 'No due date' %></div></div><% }) %></section></main><script src="/js/navbar.js"></script></body></html>
