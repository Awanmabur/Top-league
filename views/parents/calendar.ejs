<!DOCTYPE html>
<html lang="en"><head><meta charset="utf-8" /><title>Academic Calendar — <%= tenant?.name || "Classic Academy" %></title><meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" crossorigin="anonymous" referrerpolicy="no-referrer" /><link rel="stylesheet" href="/css/navbar.css" /><link rel="stylesheet" href="/css/parent-portal.css" /></head>
<body data-portal="parent"><%- include("./navbar") %><main class="main">
<div class="topbar"><div><div class="title">Academic Calendar</div><div class="subtitle">Published dates for your linked child.</div></div></div>
<% if (children?.length) { %><section class="card"><form method="get" action="/parent/calendar"><label for="calendarChild"><strong>Child</strong></label><select id="calendarChild" name="student"><% children.forEach(function(child){ %><option value="<%= child._id %>" <%= student && String(student._id)===String(child._id) ? "selected" : "" %>><%= child.fullName || [child.firstName,child.lastName].filter(Boolean).join(" ") || child.regNo %></option><% }); %></select> <button class="btn light" type="submit">View</button></form></section><% } %>
<section class="card"><div class="section-title"><%= student ? (student.fullName || student.regNo) : "Academic Calendar" %></div><div class="notif-list" style="margin-top:12px;">
<% if (events?.length) { events.forEach(function(event){ %><div class="notif-item"><div class="notif-icon"><i class="fa-solid fa-calendar-day"></i></div><div><div class="notif-title"><%= event.title %></div><div class="notif-meta"><%= event.startKey %><%= event.endKey && event.endKey!==event.startKey ? " to "+event.endKey : "" %> • <%= event.type %><%= event.location ? " • "+event.location : "" %></div><% if(event.notes){ %><div class="small-muted"><%= event.notes %></div><% } %></div></div><% }); } else { %><div class="small-muted"><%= error || "No published calendar events currently apply." %></div><% } %>
</div></section></main></div><script src="/js/navbar.js"></script></body></html>
