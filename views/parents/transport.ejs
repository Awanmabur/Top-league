<!DOCTYPE html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Transport - <%= tenant?.name || 'Classic Academy' %></title><link rel="stylesheet" href="/css/student-portal.css"><link rel="stylesheet" href="/css/navbar.css"></head><body data-portal="parent"><%- include('./navbar') %><main class="main"><div class="topbar"><div><div class="title">Transport</div><div class="subtitle">View your child’s current school transport assignment.</div></div></div><% if (children?.length) { %><section class="card"><div class="actions"><% children.forEach(function(c){ %><a class="btn <%= student && String(student._id)===String(c._id)?'primary':'light' %>" href="/parent/transport?student=<%= encodeURIComponent(String(c._id)) %>"><%= c.fullName || c.regNo %></a><% }) %></div></section><% } %><section class="card"><% if (!student) { %><div class="muted">No linked student found.</div><% } else if (!assignment) { %><div class="section-title">No active transport assignment</div><p class="muted"><%= student.fullName %> is not currently assigned to a school transport route.</p><% } else { const r=assignment.route; %><div class="section-title"><%= r.routeName %> <span class="muted">(<%= r.routeCode %>)</span></div><div class="kpi-row"><div class="card"><div class="section-title">Pickup</div><div><%= assignment.pickupPoint %></div></div><div class="card"><div class="section-title">Vehicle</div><div><%= r.vehicleName || '—' %></div><div class="muted"><%= r.vehicleRegNo || '' %></div></div><div class="card"><div class="section-title">Driver</div><div><%= r.driverName || '—' %></div><div class="muted"><%= r.driverPhone || '' %></div></div><div class="card"><div class="section-title">Fee</div><div><%= Number(assignment.feeAmountSnapshot || 0).toLocaleString() %></div></div></div><% } %></section></main><script src="/js/navbar.js"></script></body></html>
