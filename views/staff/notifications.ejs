<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <title><%= pageTitle || "Notifications" %> - <%= tenant?.name || "Classic Academy" %></title>
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" crossorigin="anonymous" referrerpolicy="no-referrer" />
  <link rel="stylesheet" href="/css/navbar.css" />
  <link rel="stylesheet" href="/css/student-portal.css" />
</head>
<body>
  <%- include("./navbar") %>
  <main class="main">
    <div class="topbar">
      <div>
        <div class="title">Notifications</div>
        <div class="subtitle">Recent account and school updates for you.</div>
      </div>
      <form method="POST" action="/staff/notifications/read-all">
        <% if (typeof csrfToken !== "undefined" && csrfToken) { %><input type="hidden" name="_csrf" value="<%= csrfToken %>"><% } %>
        <button class="btn light" type="submit"><i class="fa-solid fa-check-double"></i> Mark all read</button>
      </form>
    </div>

    <section class="card" style="margin-bottom:16px;">
      <div class="section-title">Notification Preferences</div>
      <div class="section-sub">Choose optional in-app categories. System notices always remain enabled.</div>
      <form method="POST" action="/staff/notifications/preferences" style="display:grid;gap:10px;margin-top:12px;">
        <% if (typeof csrfToken !== "undefined" && csrfToken) { %><input type="hidden" name="_csrf" value="<%= csrfToken %>"><% } %>
        <label><input type="checkbox" name="inApp" <%= preference?.inApp !== false ? 'checked' : '' %>> In-app notifications</label>
        <div style="display:flex;gap:12px;flex-wrap:wrap;">
          <% (preferenceCategories || []).filter(function(c){ return c !== 'system'; }).forEach(function(category){ %>
            <label><input type="checkbox" name="<%= category %>" <%= preference?.[category] !== false ? 'checked' : '' %>> <%= category.replace(/_/g,' ').replace(/\b\w/g,function(x){return x.toUpperCase();}) %></label>
          <% }); %>
          <label><input type="checkbox" checked disabled> System (required)</label>
        </div>
        <div><button class="btn primary" type="submit"><i class="fa-solid fa-floppy-disk"></i> Save preferences</button></div>
      </form>
    </section>

    <section class="card">
      <div class="notif-list">
        <% if (items?.length) { %>
          <% items.forEach(function(item) { %>
            <div class="notif-item">
              <div class="notif-icon"><i class="fa-solid fa-bell"></i></div>
              <div style="flex:1;">
                <div class="notif-title"><%= item.title || item.subject || "Notification" %></div>
                <div class="notif-meta"><%= item.message || item.body || "" %></div>
              </div>
              <% if (!item.readAt) { %>
                <form method="post" action="/staff/notifications/<%= item._id %>/read">
                  <% if (typeof csrfToken !== "undefined" && csrfToken) { %><input type="hidden" name="_csrf" value="<%= csrfToken %>"><% } %>
                  <button class="btn light" type="submit">Mark Read</button>
                </form>
              <% } %>
            </div>
          <% }) %>
        <% } else { %>
          <div class="small-muted">No notifications found.</div>
        <% } %>
      </div>
    </section>
  </main>
  </div>
  <script src="/js/navbar.js"></script>
</body>
</html>
