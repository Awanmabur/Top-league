<!DOCTYPE html>
<html lang="en"><head><meta charset="utf-8" /><title>Academic Calendar — <%= tenant?.name || "Classic Academy" %></title><meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" crossorigin="anonymous" referrerpolicy="no-referrer" /><link rel="stylesheet" href="/css/navbar.css" /><link rel="stylesheet" href="/css/student-portal.css" /></head>
<body data-portal="staff"><%- include("./navbar") %><main class="main"><div class="topbar"><div><div class="title">Academic Calendar</div><div class="subtitle">Published school-wide and academic-scope dates.</div></div></div>
<section class="card"><div class="section-title">Published dates</div><div class="notif-list" style="margin-top:12px;"><% if(events?.length){ events.forEach(function(event){ %><div class="notif-item"><div class="notif-icon"><i class="fa-solid fa-calendar-day"></i></div><div><div class="notif-title"><%= event.title %></div><div class="notif-meta"><%= event.startKey %><%= event.endKey && event.endKey!==event.startKey ? " to "+event.endKey : "" %> • <%= event.type %><%= event.location ? " • "+event.location : "" %></div><% if(event.className || event.sectionName || event.streamName){ %><div class="small-muted"><%= [event.className,event.sectionName,event.streamName].filter(Boolean).join(" • ") %></div><% } %></div></div><% }); } else { %><div class="small-muted">No published academic-calendar events.</div><% } %></div></section>
</main></div><script src="/js/navbar.js"></script></body></html>
