<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <title><%= pageTitle || "Payroll" %> - <%= tenant?.name || "Classic Academy" %></title>
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" crossorigin="anonymous" referrerpolicy="no-referrer" />
  <link rel="stylesheet" href="/css/navbar.css" />
  <link rel="stylesheet" href="/css/student-portal.css" />
</head>
<body>
  <%- include("./navbar") %>
  <main class="main">
    <div class="topbar">
      <div>
        <div class="title">Payroll</div>
        <div class="subtitle">Your approved payroll and payment history.</div>
      </div>
    </div>

    <% if (error) { %><section class="card"><div class="small-muted"><%= error %></div></section><% } %>

    <section class="card">
      <div class="mini-list">
        <% if (items?.length) { %>
          <% items.forEach(function(item) { %>
            <div class="mini-item" style="align-items:flex-start;">
              <div>
                <div style="font-weight:800"><%= item.title || "Payroll item" %></div>
                <div class="small-muted"><%= item.runNumber || "" %><%= item.payDate ? ` • Pay date ${item.payDate}` : "" %></div>
                <div class="small-muted" style="margin-top:4px;">Basic <%= Number(item.basicSalary || 0).toLocaleString() %> • Allowances <%= Number(item.allowances || 0).toLocaleString() %> • Bonuses <%= Number(item.bonuses || 0).toLocaleString() %> • Deductions <%= Number(item.deductions || 0).toLocaleString() %></div>
                <% if (item.status === "Held" && item.heldReason) { %><div class="small-muted" style="margin-top:4px;">Hold: <%= item.heldReason %></div><% } %>
                <% if (item.paymentReference) { %><div class="small-muted" style="margin-top:4px;">Reference: <%= item.paymentReference %></div><% } %>
              </div>
              <div style="text-align:right;white-space:nowrap;">
                <div style="font-weight:900"><%= Number(item.netPay || 0).toLocaleString() %></div>
                <div class="small-muted"><%= item.status %><%= item.paidAt ? ` • ${item.paidAt}` : "" %></div>
              </div>
            </div>
          <% }) %>
        <% } else { %>
          <div class="small-muted">No approved payroll items available.</div>
        <% } %>
      </div>
    </section>
  </main>
  </div>
  <script src="/js/navbar.js"></script>
</body>
</html>
