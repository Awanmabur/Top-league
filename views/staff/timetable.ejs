<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <title><%= pageTitle || "Timetable" %> - <%= tenant?.name || "Classic Academy" %></title>
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" crossorigin="anonymous" referrerpolicy="no-referrer" />
  <link rel="stylesheet" href="/css/navbar.css" />
  <link rel="stylesheet" href="/css/student-portal.css" />
</head>
<body data-portal="staff">
  <%- include("./navbar") %>
  <main class="main">
    <div class="topbar"><div><div class="title">Teaching Timetable</div><div class="subtitle">Your published teaching schedule. Today is <strong><%= todayName || "" %></strong>; current week is <strong><%= weekParity || "all" %></strong>.</div></div></div>
    <section class="card">
      <div class="mini-list">
        <% if (items?.length) { %>
          <% items.forEach(function(item) { %>
            <div class="mini-item">
              <span><strong><%= item.dayLabel || item.day || "-" %></strong> · <%= item.subjectCode ? (item.subjectCode + " - ") : "" %><%= item.subjectName || "Subject" %> · <%= item.className || "Class" %><%= item.sectionName ? (" / " + item.sectionName) : "" %><%= item.streamName ? (" / " + item.streamName) : "" %></span>
              <span><%= item.startTime || "-" %> to <%= item.endTime || "-" %> · <%= item.room || "TBA" %> · <%= item.weekPattern === "all" ? "Every week" : (item.weekPattern + " weeks") %><%= item.isToday && item.appliesThisWeek ? " · Today" : "" %></span>
            </div>
          <% }) %>
        <% } else { %><div class="small-muted">No published timetable entries found.</div><% } %>
      </div>
    </section>
  </main>
  <script src="/js/navbar.js"></script>
</body>
</html>
