<!DOCTYPE html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Departments</title><link rel="stylesheet" href="/css/navbar.css"><link rel="stylesheet" href="/css/student-portal.css"><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">  <link rel="stylesheet" href="/css/tenant-controls.css">
</head><body>
<%- include('../partials/navbar') %>
<main class="portal-main" style="max-width:1280px;margin:0 auto;padding:24px"><div style="display:flex;justify-content:space-between;gap:12px;align-items:center;flex-wrap:wrap"><div><h1>Departments</h1><p>Canonical HR and payroll department catalog.</p></div><a class="btn" href="/admin/departments/export.csv">Export CSV</a></div>
<% (messages?.success||[]).forEach(function(m){ %><div class="alert alert-success"><%= m %></div><% }) %><% (messages?.error||[]).forEach(function(m){ %><div class="alert alert-danger"><%= m %></div><% }) %>
<section style="display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:12px;margin:18px 0"><div class="card"><b><%= kpis.total %></b><div>Total</div></div><div class="card"><b><%= kpis.active %></b><div>Active</div></div><div class="card"><b><%= kpis.referenced %></b><div>Referenced</div></div><div class="card"><b><%= kpis.quarantined %></b><div>Recovered / review</div></div></section>
<section class="card" style="margin-bottom:18px"><h2>Create department</h2><form method="post" action="/admin/departments" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:10px"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input name="name" placeholder="Department name" required><input name="code" placeholder="Code" required><input name="costCenter" placeholder="Cost center"><select name="status"><option value="active">Active</option><option value="inactive">Inactive</option></select><textarea name="description" placeholder="Description" style="grid-column:1/-1"></textarea><button class="btn" type="submit">Create department</button></form></section>
<form method="get" style="display:flex;gap:8px;flex-wrap:wrap;margin-bottom:14px"><input name="q" value="<%= query.q %>" placeholder="Search departments"><select name="status"><option value="all">All statuses</option><% ['active','inactive','archived'].forEach(function(s){ %><option value="<%= s %>" <%= query.status===s?'selected':'' %>><%= s %></option><% }) %></select><button class="btn" type="submit">Filter</button></form>
<section style="display:grid;gap:14px"><% departments.forEach(function(d){ %><article class="card"><form method="post" action="/admin/departments/<%= d.id %>/update" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:8px"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="revision" value="<%= d.revision %>"><input name="name" value="<%= d.name %>" required><input name="code" value="<%= d.code %>" required><input name="costCenter" value="<%= d.costCenter %>"><select name="status"><% ['active','inactive','archived'].forEach(function(s){ %><option value="<%= s %>" <%= d.status===s?'selected':'' %>><%= s %></option><% }) %></select><textarea name="description" style="grid-column:1/-1"><%= d.description %></textarea><div style="grid-column:1/-1">Staff: <b><%= d.refs.staff %></b> · Payroll runs: <b><%= d.refs.payrollRuns %></b> · Payroll items: <b><%= d.refs.payrollItems %></b><% if(d.quarantined){ %> · <b>review required</b><% } %></div><button class="btn" type="submit">Save</button></form><div style="display:flex;gap:8px;margin-top:8px;flex-wrap:wrap"><form method="post" action="/admin/departments/<%= d.id %>/status"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="revision" value="<%= d.revision %>"><input type="hidden" name="status" value="<%= d.status==='active'?'inactive':'active' %>"><button class="btn" type="submit"><%= d.status==='active'?'Deactivate':'Activate' %></button></form><form method="post" action="/admin/departments/<%= d.id %>/delete" data-confirm="Delete this unreferenced department?"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="revision" value="<%= d.revision %>"><button class="btn" type="submit">Delete</button></form></div></article><% }) %><% if(!departments.length){ %><div class="card">No departments found.</div><% } %></section></main>  <script src="/js/tenant-workspace-motion.js" defer></script>
</body></html>
