<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <title>Assignment Submissions — <%= tenant?.name || "Classic Academy" %></title>
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" crossorigin="anonymous" referrerpolicy="no-referrer" />
  <link rel="stylesheet" href="/css/navbar.css" />
  <link rel="stylesheet" href="/css/student-portal.css" />
  <style nonce="<%= cspNonce %>">
    .table-wrap{overflow:auto}.sub-table{width:100%;min-width:1100px;border-collapse:collapse}.sub-table th,.sub-table td{padding:10px;border-bottom:1px solid #e2e8f0;text-align:left;vertical-align:top}.sub-table th{font-size:12px;color:#64748b}.textarea,.input{padding:9px 10px;border:1px solid #cbd5e1;border-radius:10px}.textarea{min-width:260px;min-height:70px;resize:vertical}.input{width:100px}.status{display:inline-flex;padding:5px 9px;border-radius:999px;background:#eef2ff;color:#3730a3;font-size:12px;font-weight:800}.status.graded{background:#ecfdf3;color:#166534}.status.submitted{background:#eff6ff;color:#1d4ed8}.late{color:#9a3412;font-weight:800}.submission-text{white-space:pre-wrap;max-width:360px}.links{display:grid;gap:4px;max-width:300px}.links a{overflow-wrap:anywhere}
  </style>
  <link rel="stylesheet" href="/css/tenant-controls.css">
</head>
<body data-portal="tenant">
<div class="app"><%- include("../partials/navbar") %><main class="main">
  <div class="topbar"><div><a href="/admin/assignments" style="text-decoration:none;font-weight:800;"><i class="fa-solid fa-arrow-left"></i> Assignments</a><div class="title" style="margin-top:8px;"><%= assignment.title %></div><div class="subtitle"><%= assignment.course?.code ? assignment.course.code + ' — ' : '' %><%= assignment.course?.title || assignment.courseName || 'Subject' %> • <%= assignment.totalPoints %> points</div></div></div>
  <% if (messages?.success?.length || messages?.error?.length) { %><div style="display:grid;gap:8px;margin-bottom:12px;"><% (messages.success||[]).forEach(function(m){ %><div class="card" style="background:#ecfdf3;color:#166534;"><%= m %></div><% }); (messages.error||[]).forEach(function(m){ %><div class="card" style="background:#fef2f2;color:#991b1b;"><%= m %></div><% }); %></div><% } %>
  <section class="card"><div class="section-title">Student submissions</div><div class="section-sub">Grading is limited to submitted work. Graded work must be reopened before its score can be corrected.</div>
    <div class="table-wrap" style="margin-top:12px;"><table class="sub-table"><thead><tr><th>Student</th><th>Status</th><th>Submitted</th><th>Work</th><th>Evidence</th><th>Grade / Feedback</th></tr></thead><tbody>
    <% if (submissions?.length) { submissions.forEach(function(s){ const student=s.student||{}; %><tr>
      <td><strong><%= student.fullName || student.regNo || student.studentNo || 'Student' %></strong><div class="section-sub"><%= student.regNo || student.studentNo || '' %></div></td>
      <td><span class="status <%= s.status %>"><%= s.status %></span><% if (s.isLate) { %><div class="late">Late</div><% } %></td>
      <td><%= s.lastSubmittedAt ? new Date(s.lastSubmittedAt).toLocaleString() : '—' %><div class="section-sub">Revision <%= Number(s.revision||0) %></div></td>
      <td><div class="submission-text"><%= s.text || '—' %></div></td>
      <td><div class="links"><% if (s.attachmentUrls?.length) { s.attachmentUrls.forEach(function(url,i){ %><a href="<%= url %>" target="_blank" rel="noopener noreferrer">Evidence <%= i+1 %></a><% }) } else { %>—<% } %></div></td>
      <td>
        <% if (s.status === 'submitted') { %><form method="POST" action="/admin/assignments/<%= assignment._id %>/submissions/<%= s._id %>/grade" style="display:grid;gap:7px;">
          <% if (csrfToken) { %><input type="hidden" name="_csrf" value="<%= csrfToken %>"><% } %><label>Score / <%= assignment.totalPoints %></label><input class="input" type="number" name="score" min="0" max="<%= assignment.totalPoints %>" step="0.01" required /><textarea class="textarea" name="feedback" maxlength="4000" placeholder="Feedback"></textarea><button class="btn primary" type="submit">Grade</button></form>
        <% } else if (s.status === 'graded') { %><strong><%= s.score %>/<%= assignment.totalPoints %> (<%= s.percentage %>%)</strong><div class="submission-text" style="margin-top:6px;"><%= s.feedback || 'No written feedback.' %></div><form method="POST" action="/admin/assignments/<%= assignment._id %>/submissions/<%= s._id %>/reopen" style="margin-top:8px;" data-confirm="Reopen this grade for correction?"><% if (csrfToken) { %><input type="hidden" name="_csrf" value="<%= csrfToken %>"><% } %><button class="btn light" type="submit">Reopen grade</button></form>
        <% } else { %><span class="section-sub">Withdrawn/draft — no grade can be entered.</span><% } %>
      </td>
    </tr><% }) } else { %><tr><td colspan="6">No submissions yet.</td></tr><% } %>
    </tbody></table></div>
  </section>
</main></div><script src="/js/navbar.js"></script>
  <script src="/js/tenant-workspace-motion.js" defer></script>
</body>
</html>
