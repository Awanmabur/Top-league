<!DOCTYPE html>
<html lang="en">
<%
  const h = publicHome || {};
  const p = h.profile || {};
  const b = h.branding || {};
  const contact = p.contact || {};
  const socials = p.socials || {};
  const admissions = h.admissions || p.admissions || {};
  const schoolName = p.shortName || h.tenant?.name || tenant?.name || "School";
  const tagline = p.tagline || p.motto || "Official school website";
  const initials = schoolName.split(/\\s+/).filter(Boolean).slice(0,2).map((v)=>v.charAt(0).toUpperCase()).join("") || "CA";
  const logoUrl = b.logoUrl || "";
  const coverUrl = b.coverUrl || (h.gallery || [])[0]?.url || "";
  const primary = b.primaryColor || "#0a3d62";
  const accent = b.accentColor || "#4a90e2";
  const secondary = b.secondaryColor || "#083454";
  const textColor = b.textColor || "#0f172a";
  const stats = h.stats || {};
  const statItems = [[stats.students,"Students","fa-user-graduate"],[stats.subjects,"Subjects","fa-book-open"],[stats.staff,"Staff","fa-users"],[stats.campuses,"Campuses","fa-building"]];
  const showGallery = h.preferences?.showGallery !== false && (h.gallery || []).length;
  const phone = admissions.admissionPhone || contact.phone || contact.altPhone || "";
  const email = contact.admissionsEmail || contact.email || "";
  const address = contact.addressFull || h.locationLabel || "";
  const tenantSeo = p.seo || {};
  const seoTitle = tenantSeo.metaTitle || `${schoolName} | Official School Website`;
  const seoDescription = String(tenantSeo.metaDescription || tagline || p.about || `Official website of ${schoolName}`).replace(/\s+/g," ").trim().slice(0,160);
  const seoCanonical = publicCanonicalUrl || publicSiteUrl || "";
  const seoImage = tenantSeo.ogImageUrl || coverUrl || logoUrl || "";
  const seoIndexable = tenantSeo.indexable !== false;
  const seoSameAs = [socials.facebook,socials.instagram,socials.x,socials.youtube,socials.tiktok,socials.linkedin,contact.website].filter(Boolean);
%>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title><%= seoTitle %></title>
  <meta name="description" content="<%= seoDescription %>">
  <meta name="robots" content="<%= seoIndexable ? 'index,follow,max-snippet:-1,max-image-preview:large,max-video-preview:-1' : 'noindex,nofollow' %>">
  <% if (seoCanonical) { %><link rel="canonical" href="<%= seoCanonical %>"><% } %>
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="<%= schoolName %>">
  <meta property="og:title" content="<%= seoTitle %>">
  <meta property="og:description" content="<%= seoDescription %>">
  <% if (seoCanonical) { %><meta property="og:url" content="<%= seoCanonical %>"><% } %>
  <% if (seoImage) { %><meta property="og:image" content="<%= seoImage %>"><meta property="og:image:alt" content="<%= schoolName %>"><% } %>
  <meta name="twitter:card" content="<%= seoImage ? 'summary_large_image' : 'summary' %>">
  <meta name="twitter:title" content="<%= seoTitle %>">
  <meta name="twitter:description" content="<%= seoDescription %>">
  <% if (seoImage) { %><meta name="twitter:image" content="<%= seoImage %>"><% } %>
  <% if (tenantSeo.structuredDataEnabled !== false && seoCanonical) { %>
  <script nonce="<%= cspNonce %>" type="application/ld+json"><%- JSON.stringify({
    "@context":"https://schema.org",
    "@graph":[
      {
        "@type":"EducationalOrganization",
        "@id":`${seoCanonical}#school`,
        "name":schoolName,
        "url":seoCanonical,
        "description":seoDescription,
        ...(logoUrl ? {"logo":logoUrl} : {}),
        ...(seoImage ? {"image":seoImage} : {}),
        ...(phone ? {"telephone":phone} : {}),
        ...(email ? {"email":email} : {}),
        ...(p.foundedYear ? {"foundingDate":String(p.foundedYear)} : {}),
        ...(address ? {"address":{"@type":"PostalAddress","streetAddress":address,...(p.location?.city?{"addressLocality":p.location.city}:{}),...(p.location?.country?{"addressCountry":p.location.country}:{})}} : {}),
        ...(seoSameAs.length ? {"sameAs":seoSameAs} : {})
      },
      {"@type":"WebSite","@id":`${seoCanonical}#website`,"url":seoCanonical,"name":schoolName,"publisher":{"@id":`${seoCanonical}#school`}}
    ]
  }).replace(/</g,"\\u003c") %></script>
  <% } %>
  <% if (b.faviconUrl || logoUrl) { %><link rel="icon" href="<%= b.faviconUrl || logoUrl %>"><% } %>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" crossorigin="anonymous" referrerpolicy="no-referrer">
  <link rel="stylesheet" href="/css/tenant-public-polish.css">
  <link rel="stylesheet" href="/css/classic-motion.css">
  <style nonce="<%= cspNonce %>">
    :root{--primary:<%= primary %>;--accent:<%= accent %>;--secondary:<%= secondary %>;--text:<%= textColor %>;--muted:#667085;--paper:#fff;--soft:#f3f9ff;--line:#dce9f4;--radius:26px;--shadow:0 18px 55px rgba(15,57,92,.10)}
    *{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;font-family:Outfit,system-ui,-apple-system,Segoe UI,Roboto,Arial,sans-serif;color:var(--text);background:#fff}a{text-decoration:none;color:inherit}img{max-width:100%}.wrap{width:min(1320px,calc(100% - 40px));margin:auto}.top{position:sticky;top:0;z-index:20;background:rgba(255,255,255,.94);backdrop-filter:blur(14px);border-bottom:1px solid var(--line)}.nav{min-height:76px;display:flex;align-items:center;justify-content:space-between;gap:20px}.brand{display:flex;align-items:center;gap:12px;min-width:0}.mark{width:48px;height:48px;border-radius:16px;border:1px solid var(--line);background:var(--soft);display:grid;place-items:center;overflow:hidden;color:var(--primary);font-weight:1000}.mark img{width:100%;height:100%;object-fit:contain;padding:4px}.brand-text{min-width:0}.brand-text strong{display:block;font-size:17px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.brand-text span{display:block;color:var(--muted);font-size:11px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.links{display:flex;align-items:center;gap:4px}.links a{padding:9px 10px;border-radius:12px;font-size:12px;font-weight:850}.links a:hover{background:var(--soft)}.actions{display:flex;gap:8px}.btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;border-radius:15px;padding:11px 14px;font-size:12px;font-weight:900;border:1px solid var(--line);background:#fff}.btn.primary{background:var(--accent);border-color:var(--accent);color:#fff}.btn.dark{background:var(--primary);border-color:var(--primary);color:#fff}.menu{display:none;border:1px solid var(--line);background:#fff;width:44px;height:44px;border-radius:14px}.mobile{display:none;padding:0 0 14px}.mobile a{display:block;padding:10px 4px;font-weight:800;font-size:13px}
    .hero{padding:34px 0 22px}.hero-grid{display:grid;grid-template-columns:1.05fr .95fr;gap:16px}.hero-copy,.hero-media{border:1px solid var(--line);border-radius:var(--radius);overflow:hidden;min-height:500px}.hero-copy{padding:clamp(28px,4vw,56px);display:flex;flex-direction:column;justify-content:center;background:var(--soft)}.eyebrow{display:inline-flex;align-items:center;gap:8px;width:max-content;max-width:100%;padding:8px 12px;border-radius:999px;background:#fff;border:1px solid var(--line);font-size:11px;font-weight:900;color:var(--primary)}h1{font-size:clamp(40px,5vw,68px);line-height:.98;letter-spacing:-.045em;margin:18px 0 15px;max-width:13ch}.hero-copy p{font-size:15px;line-height:1.7;color:var(--muted);max-width:65ch;margin:0}.hero-cta{display:flex;gap:9px;flex-wrap:wrap;margin-top:24px}.hero-meta{display:flex;gap:8px;flex-wrap:wrap;margin-top:20px}.hero-meta span{background:#fff;border:1px solid var(--line);border-radius:14px;padding:9px 11px;font-size:11px;font-weight:800;color:#536579}.hero-media{position:relative;background:var(--primary)}.hero-media img{width:100%;height:100%;object-fit:cover;display:block}.hero-media.no-image{display:grid;place-items:center;background:var(--primary);color:#fff}.hero-media.no-image .big-mark{font-size:84px;font-weight:1000;letter-spacing:-.06em}.hero-media .logo-float{position:absolute;left:18px;bottom:18px;width:74px;height:74px;border-radius:22px;background:#fff;border:1px solid rgba(255,255,255,.8);box-shadow:0 16px 40px rgba(0,0,0,.18);display:grid;place-items:center;overflow:hidden}.hero-media .logo-float img{width:100%;height:100%;object-fit:contain;padding:7px}
    section.block{padding:38px 0}.head{display:flex;align-items:end;justify-content:space-between;gap:15px;margin-bottom:16px}.head h2{margin:0;font-size:clamp(26px,3vw,38px);letter-spacing:-.03em}.head p{margin:6px 0 0;color:var(--muted);font-size:13px;line-height:1.6;max-width:75ch}.cards{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}.card{border:1px solid var(--line);border-radius:22px;background:#fff;padding:20px}.card .ico{width:42px;height:42px;border-radius:14px;background:var(--soft);display:grid;place-items:center;color:var(--accent);margin-bottom:14px}.card h3{margin:0 0 8px;font-size:17px}.card p{margin:0;color:var(--muted);font-size:13px;line-height:1.65}.stats{display:grid;grid-template-columns:repeat(4,1fr);gap:10px}.stat{padding:18px;border:1px solid var(--line);border-radius:20px;background:#fff}.stat i{color:var(--accent)}.stat strong{display:block;font-size:28px;margin-top:12px}.stat span{font-size:12px;color:var(--muted)}
    .about-grid{display:grid;grid-template-columns:1.1fr .9fr;gap:12px}.about-main{padding:28px;border:1px solid var(--line);border-radius:24px;background:#fff}.about-main p{color:var(--muted);line-height:1.8;margin:0}.about-side{display:grid;gap:12px}.mini-card{border:1px solid var(--line);border-radius:22px;padding:20px;background:var(--soft)}.mini-card h3{margin:0 0 8px}.mini-card p{margin:0;color:var(--muted);line-height:1.65;font-size:13px}.chips{display:flex;flex-wrap:wrap;gap:8px}.chip{padding:9px 11px;border-radius:999px;background:var(--soft);border:1px solid var(--line);font-size:12px;font-weight:800;color:#4d6378}
    .program-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}.program{border:1px solid var(--line);border-radius:19px;padding:16px;background:#fff;display:flex;align-items:center;gap:11px;font-weight:850;font-size:13px}.program i{color:var(--accent)}.admissions-box{border:1px solid var(--line);border-radius:26px;background:var(--soft);padding:28px;display:grid;grid-template-columns:1.05fr .95fr;gap:20px}.details{display:grid;gap:10px}.detail{background:#fff;border:1px solid var(--line);border-radius:17px;padding:13px}.detail b{font-size:12px}.detail div{margin-top:4px;color:var(--muted);font-size:12px;line-height:1.55}.list{display:grid;gap:8px}.list div{display:flex;gap:8px;align-items:flex-start;font-size:13px;color:#475467}.list i{color:var(--accent);margin-top:3px}.gallery{display:grid;grid-template-columns:repeat(4,1fr);gap:10px}.photo{border-radius:20px;overflow:hidden;aspect-ratio:4/3;background:var(--soft);border:1px solid var(--line)}.photo img{width:100%;height:100%;object-fit:cover;display:block}.news{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}.news article{border:1px solid var(--line);border-radius:20px;padding:18px}.news time{font-size:11px;color:var(--muted)}.news h3{margin:7px 0 8px;font-size:16px}.news p{margin:0;color:var(--muted);font-size:12px;line-height:1.6}
    .contact-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px}.contact-card{border:1px solid var(--line);border-radius:24px;padding:24px;background:#fff}.contact-list{display:grid;gap:12px}.contact-line{display:flex;gap:11px;align-items:flex-start}.contact-line i{color:var(--accent);margin-top:4px}.contact-line strong{display:block;font-size:12px}.contact-line span,.contact-line a{display:block;color:var(--muted);font-size:13px;margin-top:3px}.social{display:flex;gap:8px;flex-wrap:wrap;margin-top:18px}.social a{width:40px;height:40px;border-radius:13px;border:1px solid var(--line);display:grid;place-items:center;color:var(--primary)}.map-link{height:100%;min-height:220px;border-radius:20px;background:var(--soft);display:grid;place-items:center;text-align:center;padding:20px;color:var(--primary);font-weight:900}
    footer{margin-top:38px;border-top:1px solid var(--line);background:#f8fbfe}.foot{padding:28px 0;display:flex;align-items:center;justify-content:space-between;gap:20px}.foot p{margin:5px 0 0;color:var(--muted);font-size:12px}.foot-links{display:flex;gap:14px;flex-wrap:wrap}.foot-links a{font-size:12px;font-weight:800;color:#607287}
    @media(max-width:980px){.links,.actions{display:none}.menu{display:grid;place-items:center}.hero-grid,.about-grid,.admissions-box,.contact-grid{grid-template-columns:1fr}.hero-copy,.hero-media{min-height:420px}.cards,.program-grid,.news{grid-template-columns:repeat(2,1fr)}.gallery{grid-template-columns:repeat(3,1fr)}.stats{grid-template-columns:repeat(2,1fr)}}
    @media(max-width:640px){.wrap{width:min(100% - 24px,1320px)}.nav{min-height:68px}.hero{padding-top:18px}.hero-copy,.hero-media{min-height:auto}.hero-media{aspect-ratio:4/3}.hero-copy{padding:26px}.cards,.program-grid,.news,.gallery{grid-template-columns:1fr}.head{align-items:flex-start}.stats{grid-template-columns:repeat(2,1fr)}.foot{align-items:flex-start;flex-direction:column}.brand-text span{max-width:220px}}
  </style>
  <link rel="stylesheet" href="/css/tenant-controls.css">
</head>
<body>
<%- include("./partials/site-nav") %>

<main>
<section class="hero"><div class="wrap"><div class="hero-grid"><div class="hero-copy"><span class="eyebrow"><i class="fa-solid fa-circle-check"></i> <%= p.verified ? 'Verified school profile' : 'Official school website' %></span><h1><%= schoolName %></h1><p><%= p.tagline || p.about || `Welcome to the official ${schoolName} website.` %></p><div class="hero-cta"><% if (admissions.isOpen !== false) { %><a class="btn primary" href="<%= admissions.applyUrl || '/apply' %>"><i class="fa-solid fa-file-pen"></i> Apply for admission</a><% } %><a class="btn" href="/admissions/status"><i class="fa-solid fa-magnifying-glass"></i> Check application</a><a class="btn" href="/login"><i class="fa-solid fa-user-graduate"></i> Open portal</a></div><div class="hero-meta"><% if (p.type) { %><span><i class="fa-solid fa-school"></i> <%= p.type %></span><% } %><% if (h.locationLabel) { %><span><i class="fa-solid fa-location-dot"></i> <%= h.locationLabel %></span><% } %><% if (p.foundedYear) { %><span><i class="fa-solid fa-calendar"></i> Since <%= p.foundedYear %></span><% } %><% if (p.system) { %><span><i class="fa-solid fa-graduation-cap"></i> <%= p.system %></span><% } %></div></div><div class="hero-media <%= coverUrl ? '' : 'no-image' %>"><% if (coverUrl) { %><img src="<%= coverUrl %>" alt="<%= schoolName %>"><% } else { %><div class="big-mark"><%= initials %></div><% } %><% if (logoUrl && coverUrl) { %><div class="logo-float"><img src="<%= logoUrl %>" alt="<%= schoolName %> logo"></div><% } %></div></div></div></section>

<% if (statItems.length) { %><section class="block"><div class="wrap"><div class="stats"><% statItems.forEach(function(item){ %><div class="stat"><i class="fa-solid <%= item[2] %>"></i><strong><%= Number(item[0]).toLocaleString() %></strong><span><%= item[1] %></span></div><% }) %></div></div></section><% } %>

<section class="block" id="about"><div class="wrap"><div class="head"><div><h2>About <%= schoolName %></h2><p><%= p.motto || tagline %></p></div></div><div class="about-grid"><div class="about-main"><p><%= p.about || `${schoolName} uses its official profile to share admissions, academics and school information with families and learners.` %></p><% if ((h.highlights||[]).length || (h.whyChooseUs||[]).length) { %><div class="chips" style="margin-top:20px"><% [...(h.highlights||[]),...(h.whyChooseUs||[])].slice(0,8).forEach(function(item){ %><span class="chip"><i class="fa-solid fa-circle-check"></i> <%= item %></span><% }) %></div><% } %></div><div class="about-side"><% if (p.mission) { %><div class="mini-card"><h3>Our Mission</h3><p><%= p.mission %></p></div><% } %><% if (p.vision) { %><div class="mini-card"><h3>Our Vision</h3><p><%= p.vision %></p></div><% } %><% if (!p.mission && !p.vision && (h.values||[]).length) { %><div class="mini-card"><h3>Our Values</h3><div class="chips"><% h.values.forEach(function(item){ %><span class="chip"><%= item %></span><% }) %></div></div><% } %></div></div></div></section>

<% if ((h.programs||[]).length) { %><section class="block" id="programs"><div class="wrap"><div class="head"><div><h2>Academics & Programs</h2><p>Explore the academic areas configured by <%= schoolName %>.</p></div></div><div class="program-grid"><% h.programs.forEach(function(item){ %><div class="program"><i class="fa-solid fa-book-open"></i><span><%= item %></span></div><% }) %></div></div></section><% } %>

<section class="block" id="admissions"><div class="wrap"><div class="head"><div><h2>Admissions</h2><p><%= admissions.isOpen === false ? 'Admissions information is currently available, but online applications are closed.' : 'Apply online and track your application securely.' %></p></div></div><div class="admissions-box"><div><h3 style="margin-top:0"><%= admissions.intakeLabel || (admissions.isOpen === false ? 'Admissions currently closed' : 'Applications are open') %></h3><p style="color:var(--muted);line-height:1.7"><%= admissions.requirements || 'Use the official application form for requirements, document upload and submission.' %></p><div class="hero-cta"><% if (admissions.isOpen !== false) { %><a class="btn primary" href="<%= admissions.applyUrl || '/apply' %>"><i class="fa-solid fa-file-pen"></i> Start application</a><% } %><a class="btn" href="/admissions/status"><i class="fa-solid fa-magnifying-glass"></i> Check status</a></div></div><div class="details"><% if (admissions.officeHours) { %><div class="detail"><b>Admissions office hours</b><div><%= admissions.officeHours %></div></div><% } %><% if (admissions.applicationFeeText || admissions.feesRange) { %><div class="detail"><b>Application / fees</b><div><%= admissions.applicationFeeText || admissions.feesRange %></div></div><% } %><% if ((admissions.requiredDocs||[]).length) { %><div class="detail"><b>Required documents</b><div class="list" style="margin-top:8px"><% admissions.requiredDocs.forEach(function(item){ %><div><i class="fa-solid fa-check"></i><span><%= item %></span></div><% }) %></div></div><% } %></div></div></div></section>

<% if ((h.facilities||[]).length || (h.values||[]).length) { %><section class="block"><div class="wrap"><div class="head"><div><h2>What defines our school</h2><p>Information published by <%= schoolName %>.</p></div></div><div class="cards"><% (h.facilities||[]).slice(0,6).forEach(function(item){ %><div class="card"><div class="ico"><i class="fa-solid fa-building-columns"></i></div><h3><%= item %></h3><p>Part of the facilities and learning environment highlighted by the school.</p></div><% }) %><% (h.values||[]).slice(0,3).forEach(function(item){ %><div class="card"><div class="ico"><i class="fa-solid fa-star"></i></div><h3><%= item %></h3><p>A value <%= schoolName %> has chosen to highlight publicly.</p></div><% }) %></div></div></section><% } %>

<% if (showGallery) { %><section class="block" id="gallery"><div class="wrap"><div class="head"><div><h2>School Gallery</h2><p>Life, learning and moments shared by <%= schoolName %>.</p></div></div><div class="gallery gallery-story"><% h.gallery.forEach(function(item,index){ const caption = item.caption || `Life at ${schoolName}`; %><figure class="photo" title="<%= caption %>"><img src="<%= item.url %>" alt="<%= caption %>" loading="lazy"><figcaption><small><%= index === 0 ? 'Featured moment' : 'School life' %></small><strong><%= caption %></strong></figcaption></figure><% }) %></div></div></section><% } %>

<% if ((h.announcements||[]).length) { %><section class="block" id="announcements"><div class="wrap"><div class="head"><div><h2>Announcements</h2><p>Important updates and notices from <%= schoolName %>.</p></div></div><div class="news"><% h.announcements.forEach(function(item,index){ const announcementDate = item.date ? new Date(item.date).toLocaleDateString() : ''; const bodyText = String(item.body || ''); const excerpt = bodyText.length > 180 ? bodyText.slice(0,177).trim() + '…' : bodyText; %><article class="news-card"><time><%= announcementDate %></time><h3><%= item.title %></h3><p class="news-excerpt"><%= excerpt %></p><div class="news-actions"><button class="btn read-more" type="button" data-announcement-open="<%= index %>"><i class="fa-solid fa-book-open"></i> Read more</button></div><div class="announcement-source" id="announcementSource-<%= index %>"><span data-source-title><%= item.title %></span><span data-source-date><%= announcementDate %></span><span data-source-body><%= bodyText %></span></div></article><% }) %></div></div></section><div class="announcement-modal" id="announcementModal" hidden><button class="announcement-backdrop" type="button" data-announcement-close aria-label="Close announcement"></button><article class="announcement-dialog" role="dialog" aria-modal="true" aria-labelledby="announcementModalTitle"><div class="announcement-dialog-top"><div><div class="modal-kicker">School announcement</div><h2 id="announcementModalTitle" data-modal-title>Announcement</h2><time data-modal-date></time></div><button class="announcement-close" type="button" data-announcement-close aria-label="Close announcement"><i class="fa-solid fa-xmark"></i></button></div><div class="announcement-dialog-body" data-modal-body></div></article></div><% } %>

<section class="block" id="contact"><div class="wrap"><div class="head"><div><h2>Contact <%= schoolName %></h2><p>Use the official contact information configured by the school.</p></div></div><div class="contact-grid"><div class="contact-card"><div class="contact-list"><% if (phone) { %><div class="contact-line"><i class="fa-solid fa-phone"></i><div><strong>Phone</strong><a href="tel:<%= phone.replace(/[^+0-9]/g,'') %>"><%= phone %></a></div></div><% } %><% if (email) { %><div class="contact-line"><i class="fa-solid fa-envelope"></i><div><strong>Email</strong><a href="mailto:<%= email %>"><%= email %></a></div></div><% } %><% if (address) { %><div class="contact-line"><i class="fa-solid fa-location-dot"></i><div><strong>Location</strong><span><%= address %></span></div></div><% } %><% if (contact.website) { %><div class="contact-line"><i class="fa-solid fa-globe"></i><div><strong>Website</strong><a href="<%= contact.website %>" target="_blank" rel="noopener noreferrer"><%= contact.website %></a></div></div><% } %></div><div class="social"><% [['facebook','fa-facebook-f'],['instagram','fa-instagram'],['x','fa-x-twitter'],['youtube','fa-youtube'],['linkedin','fa-linkedin-in'],['tiktok','fa-tiktok']].forEach(function(row){ if(socials[row[0]]) { %><a href="<%= socials[row[0]] %>" target="_blank" rel="noopener noreferrer" aria-label="<%= row[0] %>"><i class="fa-brands <%= row[1] %>"></i></a><% } }) %></div></div><div class="contact-card"><% if (p.location?.googleMapUrl) { %><a class="map-link" href="<%= p.location.googleMapUrl %>" target="_blank" rel="noopener noreferrer"><span><i class="fa-solid fa-map-location-dot" style="font-size:34px"></i><br><br>Open school location on map</span></a><% } else { %><div class="map-link"><span><i class="fa-solid fa-school" style="font-size:34px"></i><br><br><%= h.locationLabel || schoolName %></span></div><% } %></div></div></div></section>
