<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Jobs — <%= tenant?.name || 'Classic Academy' %></title><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"><link rel="stylesheet" href="/css/navbar.css"><link rel="stylesheet" href="/css/student-portal.css"></head><body data-portal="tenant"><div class="app"><%- include('../partials/navbar') %><main class="main">
<div class="topbar"><div><div class="title">Jobs & Opportunities</div><div class="subtitle">Publish student opportunities and manage applications.</div></div></div>
<% (messages.success||[]).forEach(function(m){ %><div class="card" style="margin:8px 0"><%= m %></div><% }); (messages.error||[]).forEach(function(m){ %><div class="card" style="margin:8px 0"><strong><%= m %></strong></div><% }); %>
<section class="card" style="margin-top:12px"><div class="section-title">Create opportunity</div><form method="post" action="/admin/jobs" style="display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px;margin-top:10px"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input name="title" maxlength="180" required placeholder="Title"><input name="employer" maxlength="180" required placeholder="Employer"><select name="type"><% types.forEach(function(t){ %><option><%= t %></option><% }) %></select><input name="location" maxlength="180" placeholder="Location"><input name="publishAt" type="datetime-local"><input name="deadline" type="datetime-local"><input name="eligibleClassLevels" maxlength="300" placeholder="Eligible levels, comma-separated"><input name="externalApplyUrl" maxlength="1000" placeholder="https:// employer page"><textarea name="description" maxlength="5000" required placeholder="Description" style="grid-column:1/-1"></textarea><textarea name="requirements" maxlength="3000" placeholder="Requirements" style="grid-column:1/-1"></textarea><button class="btn primary" type="submit">Create Draft</button></form></section>
<section class="card" style="margin-top:12px"><div class="section-title">Opportunities</div><div style="overflow:auto"><table style="width:100%"><thead><tr><th>Opportunity</th><th>Window</th><th>Status</th><th>Lifecycle</th></tr></thead><tbody><% if(jobs.length){ jobs.forEach(function(j){ %><tr><td><strong><%= j.title %></strong><div class="small-muted"><%= j.employer %> • <%= j.type %> • <%= j.location || '—' %></div></td><td><%= j.publishAt ? new Date(j.publishAt).toLocaleString() : 'Immediate' %><br><%= j.deadline ? new Date(j.deadline).toLocaleString() : 'No deadline' %></td><td><%= j.status %></td><td><form method="post" action="/admin/jobs/<%= j._id %>/status" style="display:flex;gap:5px"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="revision" value="<%= j.revision %>"><select name="status"><% const next={Draft:['Published','Archived'],Published:['Closed','Archived'],Closed:['Published','Archived'],Archived:[]}[j.status]||[]; next.forEach(function(x){ %><option><%= x %></option><% }) %></select><button class="btn" type="submit" <%= next.length?'':'disabled' %>>Change</button></form></td></tr><% }); } else { %><tr><td colspan="4">No opportunities yet.</td></tr><% } %></tbody></table></div></section>
<section class="card" style="margin-top:12px"><div class="section-title">Applications</div><div style="overflow:auto"><table style="width:100%"><thead><tr><th>Student</th><th>Opportunity</th><th>Status</th><th>Action</th></tr></thead><tbody><% if(applications.length){ applications.forEach(function(a){ const s=a.studentId||{}; %><tr><td><%= s.fullName || [s.firstName,s.lastName].filter(Boolean).join(' ') || s.regNo || s.studentNo || 'Student' %><div class="small-muted"><%= s.classLevel || '' %></div></td><td><%= a.jobId?.title || 'Opportunity' %><div class="small-muted"><%= a.jobId?.employer || '' %></div></td><td><%= a.status %></td><td><% const map={Submitted:['Reviewing','Shortlisted','Rejected'],Reviewing:['Shortlisted','Interview','Rejected'],Shortlisted:['Interview','Accepted','Rejected'],Interview:['Accepted','Rejected']}; const opts=map[a.status]||[]; if(opts.length){ %><form method="post" action="/admin/jobs/applications/<%= a._id %>/status" style="display:flex;gap:5px"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="revision" value="<%= a.revision %>"><select name="status"><% opts.forEach(function(x){ %><option><%= x %></option><% }) %></select><input name="note" maxlength="500" placeholder="Note"><button class="btn primary">Save</button></form><% } else { %>—<% } %></td></tr><% }); } else { %><tr><td colspan="4">No applications yet.</td></tr><% } %></tbody></table></div></section>
</main></div><script src="/js/navbar.js"></script></body></html>
