<!DOCTYPE html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Classrooms & Facilities - <%= tenant?.name || 'Classic Academy' %></title><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" crossorigin="anonymous" referrerpolicy="no-referrer"><link rel="stylesheet" href="/css/student-portal.css"><link rel="stylesheet" href="/css/navbar.css"><style nonce="<%= cspNonce %>">.grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px}.field{display:grid;gap:5px}.field input,.field select,.field textarea{padding:10px 12px;border:1px solid rgba(13,64,96,.16);border-radius:10px;width:100%}.field label{font-size:12px;font-weight:800;color:#6b7280}.full{grid-column:1/-1}.table-wrap{overflow:auto;border:1px solid rgba(13,64,96,.1);border-radius:12px}table{width:100%;border-collapse:collapse;min-width:1000px}th,td{padding:10px 12px;border-bottom:1px solid rgba(13,64,96,.08);text-align:left;font-size:13px}th{font-size:12px;color:#6b7280;text-transform:uppercase;background:rgba(13,64,96,.03)}details summary{cursor:pointer;font-weight:800}.actions{display:flex;gap:8px;flex-wrap:wrap}@media(max-width:900px){.grid{grid-template-columns:1fr}}</style></head><body data-portal="tenant"><%- include('../partials/flash') %><%- include('../partials/navbar') %><main class="main"><div class="topbar"><div><div class="title">Classrooms & Facilities</div><div class="subtitle">Register teaching spaces and keep room availability consistent with the published timetable.</div></div></div><div class="kpi-row"><div class="card"><div class="section-title">Rooms</div><div class="kpi-value"><%= kpis.rooms %></div></div><div class="card"><div class="section-title">Available</div><div class="kpi-value"><%= kpis.available %></div></div><div class="card"><div class="section-title">Maintenance</div><div class="kpi-value"><%= kpis.maintenance %></div></div><div class="card"><div class="section-title">Capacity</div><div class="kpi-value"><%= kpis.capacity %></div></div></div><section class="card"><div class="section-title">Register Classroom</div><form method="POST" action="/admin/facilities" class="grid"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="field"><label>Name</label><input name="name" required></div><div class="field"><label>Code</label><input name="code" required></div><div class="field"><label>Capacity</label><input type="number" name="capacity" min="1" value="1" required></div><div class="field"><label>Type</label><select name="type"><% ['lecture','lab','tutorial','hall','office','other'].forEach(function(x){ %><option><%= x %></option><% }) %></select></div><div class="field"><label>Campus</label><input name="campus"></div><div class="field"><label>Building</label><input name="building"></div><div class="field"><label>Floor</label><input name="floor"></div><div class="field"><label>Location</label><input name="location"></div><div class="field full"><label>Notes</label><textarea name="notes"></textarea></div><div class="field full"><button class="btn primary" type="submit">Register Classroom</button></div></form></section><section class="card"><form method="GET" action="/admin/facilities" class="actions"><input class="input" name="q" value="<%= query.q || '' %>" placeholder="Search room, code, building..."><select class="select" name="status"><option value="">All statuses</option><% ['available','maintenance','inactive','archived'].forEach(function(s){ %><option value="<%= s %>" <%= query.status===s?'selected':'' %>><%= s %></option><% }) %></select><select class="select" name="campus"><option value="">All campuses</option><% campuses.forEach(function(c){ %><option value="<%= c %>" <%= query.campus===c?'selected':'' %>><%= c %></option><% }) %></select><button class="btn light" type="submit">Filter</button><a class="btn light" href="/admin/facilities">Reset</a></form><div class="table-wrap"><table><thead><tr><th>Room</th><th>Type</th><th>Capacity</th><th>Campus / Building</th><th>Status</th><th>Published Slots</th><th>Manage</th></tr></thead><tbody><% if(!rooms.length){ %><tr><td colspan="7">No classrooms registered.</td></tr><% } %><% rooms.forEach(function(r){ %><tr><td><strong><%= r.name %></strong><br><span class="muted"><%= r.code %></span></td><td><%= r.type %></td><td><%= r.capacity %></td><td><%= r.campus || '—' %><br><span class="muted"><%= [r.building,r.floor].filter(Boolean).join(' / ') %></span></td><td><%= r.status %><% if(r.status==='maintenance'&&r.maintenanceReason){ %><br><span class="muted"><%= r.maintenanceReason %></span><% } %></td><td><%= r.activeSchedules %></td><td><details><summary>Manage</summary><form method="POST" action="/admin/facilities/<%= r._id %>" class="grid"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="revision" value="<%= r.revision %>"><div class="field"><label>Name</label><input name="name" value="<%= r.name %>" required></div><div class="field"><label>Code</label><input name="code" value="<%= r.code %>" required></div><div class="field"><label>Capacity</label><input type="number" min="1" name="capacity" value="<%= r.capacity %>" required></div><div class="field"><label>Type</label><select name="type"><% ['lecture','lab','tutorial','hall','office','other'].forEach(function(x){ %><option <%= r.type===x?'selected':'' %>><%= x %></option><% }) %></select></div><div class="field"><label>Campus</label><input name="campus" value="<%= r.campus || '' %>"></div><div class="field"><label>Building</label><input name="building" value="<%= r.building || '' %>"></div><div class="field"><label>Floor</label><input name="floor" value="<%= r.floor || '' %>"></div><div class="field"><label>Location</label><input name="location" value="<%= r.location || '' %>"></div><div class="field"><label>Status</label><select name="status"><% ['available','maintenance','inactive','archived'].forEach(function(s){ %><option value="<%= s %>" <%= r.status===s?'selected':'' %>><%= s %></option><% }) %></select></div><div class="field"><label>Maintenance Until</label><input type="date" name="maintenanceUntil" value="<%= r.maintenanceUntil ? new Date(r.maintenanceUntil).toISOString().slice(0,10) : '' %>"></div><div class="field full"><label>Maintenance Reason</label><textarea name="maintenanceReason"><%= r.maintenanceReason || '' %></textarea></div><div class="field full"><label>Notes</label><textarea name="notes"><%= r.notes || '' %></textarea></div><div class="field full"><button class="btn primary" type="submit">Save Classroom</button></div></form><% if(r.activeSchedules>0){ %><p class="muted">This room cannot enter maintenance/inactive/archive until its published timetable slots are moved or unpublished.</p><% } %></details></td></tr><% }) %></tbody></table></div></section></main><script src="/js/navbar.js"></script></body></html>
