<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <title>Payment Record — <%= tenant?.name || "Classic Academy" %></title>
  <meta name="viewport" content="width=device-width,initial-scale=1"/>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" crossorigin="anonymous" referrerpolicy="no-referrer"/>
  <style nonce="<%= cspNonce %>">
    :root{--accent:#0a6fbf;--bg:#f4f8ff;--card:#fff;--muted:#6b7280;--line:rgba(13,64,96,.12);--shadow:0 10px 30px rgba(0,0,0,.08);--radius:16px}
    *{box-sizing:border-box}body{margin:0;font-family:system-ui,-apple-system,Segoe UI,Roboto,Arial;background:var(--bg);color:#0f172a}.wrap{max-width:980px;margin:18px auto;padding:0 14px}.topbar{display:flex;justify-content:space-between;gap:10px;flex-wrap:wrap;align-items:flex-start;margin-bottom:12px}.title{font-size:18px;font-weight:1000}.subtitle{font-size:12px;color:var(--muted);margin-top:4px}.actions{display:flex;gap:10px;flex-wrap:wrap}.btn{border:none;border-radius:12px;padding:10px 12px;font-weight:900;cursor:pointer;display:inline-flex;gap:8px;align-items:center}.btn.light{background:#fff;border:1px solid var(--line);color:#0f172a}.btn.primary{background:var(--accent);color:#fff}.card{background:var(--card);border:1px solid var(--line);border-radius:var(--radius);box-shadow:var(--shadow)}.card-head{display:flex;justify-content:space-between;gap:10px;flex-wrap:wrap;align-items:center;padding:12px 14px;border-bottom:1px solid var(--line)}.card-title{font-weight:1000}.card-sub{font-size:12px;color:var(--muted)}.card-body{padding:14px}.grid{display:grid;grid-template-columns:1fr 1fr;gap:12px}.muted{color:var(--muted);font-size:12px}.strong{font-weight:1000}.divider{height:1px;background:var(--line);margin:12px 0}.stamp{border:2px dashed rgba(10,111,191,.35);border-radius:16px;padding:14px;background:rgba(10,111,191,.06)}.table-wrap{overflow:auto;border:1px solid var(--line);border-radius:12px}table{width:100%;border-collapse:separate;border-spacing:0;min-width:820px;background:#fff}th,td{padding:10px 12px;border-bottom:1px solid rgba(13,64,96,.08);vertical-align:top}th{font-size:12px;color:var(--muted);text-transform:uppercase;letter-spacing:.04em;text-align:left;background:rgba(13,64,96,.03)}.right{text-align:right}.footer-note{display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap;align-items:center;margin-top:12px}.mini{font-size:11px;color:var(--muted)}.status{display:inline-block;padding:5px 9px;border-radius:999px;border:1px solid var(--line);font-size:11px;font-weight:900}.status.completed{color:#166534;background:#f0fdf4}.status.pending{color:#92400e;background:#fffbeb}.status.voided,.status.refunded{color:#991b1b;background:#fef2f2}@media print{body{background:#fff}.actions{display:none!important}.wrap{margin:0;max-width:100%}.card{box-shadow:none}.stamp{border-style:solid;border-color:#bbb;background:#fff}}@media(max-width:720px){.grid{grid-template-columns:1fr}}
  </style>
</head>
<body data-portal="tenant">
<%
  const _tenant = tenant || null;
  const _payment = payment || null;
  const _invoice = invoice || null;
  const _student = _payment?.studentId || _invoice?.studentId || null;
  const fmt = (n)=>{ try{return new Intl.NumberFormat('en-US').format(Number(n||0));}catch(e){return String(n||0);} };
  const fullName = (s)=> s?.fullName || [s?.firstName,s?.middleName,s?.lastName].filter(Boolean).join(' ') || 'Student';
  const studentName = fullName(_student);
  const regNo = _student?.admissionNumber || _student?.regNo || '-';
  const invoiceNo = _invoice?.invoiceNumber || 'Unallocated';
  const receiptNo = _payment?.receiptNumber || '-';
  const status = _payment?.status || receiptStatus || 'Pending';
  const isCompleted = status === 'Completed';
  const issuedValue = _payment?.completedAt || _payment?.paymentDate || _payment?.createdAt;
  const issued = issuedValue ? new Date(issuedValue).toLocaleString() : '-';
  const currency = _invoice?.currency || 'UGX';
  const total = Number(_invoice?.totalAmount || 0);
  const paidToDate = Number(_invoice?.paidAmount || 0);
  const thisPay = Number(_payment?.amount || 0);
  const applied = Number(_payment?.appliedAmount || 0);
  const balance = Number(_invoice?.balance || 0);
  const items = Array.isArray(_invoice?.items) ? _invoice.items : [];
  const statusClass = String(status).toLowerCase().replace(/[^a-z]/g,'');
%>
<div class="wrap">
  <div class="topbar">
    <div>
      <div class="title"><%= isCompleted ? 'Payment Receipt' : 'Payment Record' %></div>
      <div class="subtitle"><%= isCompleted ? 'Printable receipt for a completed payment.' : 'This record is not a completed-payment receipt.' %></div>
    </div>
    <div class="actions">
      <button id="receiptBackBtn" type="button" class="btn light"><i class="fa-solid fa-arrow-left"></i> Back</button>
      <button id="receiptPrintBtn" type="button" class="btn primary"><i class="fa-solid fa-print"></i> Print</button>
    </div>
  </div>

  <section class="card">
    <div class="card-head">
      <div>
        <div class="card-title"><%= _tenant?.name || 'Classic Academy School Finance Office' %></div>
        <div class="card-sub"><%= isCompleted ? 'Official completed-payment record' : 'Finance transaction record' %></div>
      </div>
      <div>
        <div class="strong"><%= receiptNo %></div>
        <div class="muted">Recorded: <%= issued %></div>
        <div class="status <%= statusClass %>"><%= status %></div>
      </div>
    </div>

    <div class="card-body">
      <div class="grid">
        <div class="stamp">
          <div class="strong"><i class="fa-solid fa-building-columns"></i> Institution Details</div>
          <div class="divider"></div>
          <div class="muted">School / Tenant: <span class="strong"><%= _tenant?.name || 'Classic Academy' %></span></div>
          <% if (_tenant?.email) { %><div class="muted">Email: <span class="strong"><%= _tenant.email %></span></div><% } %>
        </div>
        <div class="stamp">
          <div class="strong"><i class="fa-solid fa-user-graduate"></i> Student Details</div>
          <div class="divider"></div>
          <div class="muted">Student: <span class="strong"><%= studentName %></span></div>
          <div class="muted">Admission / Reg No: <span class="strong"><%= regNo %></span></div>
          <div class="muted">Period: <span class="strong"><%= [_invoice?.academicYear || _payment?.academicYear, _invoice?.term || _payment?.term].filter(Boolean).join(' • ') || '-' %></span></div>
        </div>
      </div>

      <div class="divider"></div>
      <div class="grid">
        <div>
          <div class="strong"><i class="fa-solid fa-file-invoice"></i> Invoice Reference</div>
          <div class="muted">Invoice No: <span class="strong"><%= invoiceNo %></span></div>
          <div class="muted">Issue Date: <span class="strong"><%= _invoice?.issueDate ? new Date(_invoice.issueDate).toLocaleDateString() : '-' %></span></div>
          <div class="muted">Due Date: <span class="strong"><%= _invoice?.dueDate ? new Date(_invoice.dueDate).toLocaleDateString() : '-' %></span></div>
          <div class="muted">Invoice Status: <span class="strong"><%= _invoice?.status || 'Unallocated' %></span></div>
        </div>
        <div>
          <div class="strong"><i class="fa-solid fa-receipt"></i> Payment Summary</div>
          <div class="muted">Method: <span class="strong"><%= _payment?.method || '-' %></span></div>
          <div class="muted">Reference: <span class="strong"><%= _payment?.reference || '-' %></span></div>
          <div class="muted">Payment Date: <span class="strong"><%= _payment?.paymentDate ? new Date(_payment.paymentDate).toLocaleString() : '-' %></span></div>
        </div>
      </div>

      <% if (_invoice) { %>
      <div class="divider"></div>
      <div class="strong"><i class="fa-solid fa-list"></i> Invoice Items</div>
      <div class="table-wrap" style="margin-top:8px">
        <table>
          <thead><tr><th>Item</th><th>Description</th><th class="right">Qty</th><th class="right">Unit</th><th class="right">Amount</th></tr></thead>
          <tbody>
            <% if (!items.length) { %><tr><td colspan="5" class="muted">No line items.</td></tr><% } %>
            <% items.forEach(it => { %>
              <tr>
                <td><b><%= it.title || '-' %></b></td>
                <td class="muted"><%= it.note || '-' %></td>
                <td class="right"><%= Number(it.qty || 1) %></td>
                <td class="right"><%= currency %> <%= fmt(it.unitAmount || 0) %></td>
                <td class="right"><b><%= currency %> <%= fmt(it.amount || 0) %></b></td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
      <% } %>

      <div class="divider"></div>
      <div class="grid">
        <div class="stamp">
          <div class="strong"><i class="fa-solid fa-money-bill-wave"></i> Amounts</div>
          <div class="divider"></div>
          <% if (_invoice) { %>
            <div class="muted" style="display:flex;justify-content:space-between"><span>Invoice Total</span><span class="strong"><%= currency %> <%= fmt(total) %></span></div>
            <div class="muted" style="display:flex;justify-content:space-between"><span>Applied Paid Total</span><span class="strong"><%= currency %> <%= fmt(paidToDate) %></span></div>
          <% } %>
          <div class="muted" style="display:flex;justify-content:space-between"><span>This Payment</span><span class="strong"><%= currency %> <%= fmt(thisPay) %></span></div>
          <% if (_invoice) { %>
            <div class="muted" style="display:flex;justify-content:space-between"><span>Applied to This Invoice</span><span class="strong"><%= currency %> <%= fmt(applied) %></span></div>
            <% if (thisPay > applied) { %><div class="muted" style="display:flex;justify-content:space-between"><span>Unallocated / Account Credit</span><span class="strong"><%= currency %> <%= fmt(thisPay - applied) %></span></div><% } %>
            <div class="divider"></div>
            <div style="display:flex;justify-content:space-between"><span class="strong">Invoice Balance</span><span class="strong"><%= currency %> <%= fmt(balance) %></span></div>
          <% } %>
        </div>
        <div class="stamp">
          <div class="strong"><i class="fa-solid fa-shield-halved"></i> Record Verification</div>
          <div class="divider"></div>
          <div class="muted">Record code:</div>
          <div class="strong"><%= [receiptNo, invoiceNo].filter(Boolean).join(' • ') %></div>
          <div class="mini" style="margin-top:8px">
            <% if (isCompleted) { %>This payment is recorded as Completed in Classic Academy Finance.<% } else { %>This transaction is currently <%= status %> and must not be treated as proof of completed payment.<% } %>
          </div>
        </div>
      </div>

      <div class="footer-note">
        <div class="mini">
          <div class="strong">Record notice</div>
          <div>This document reflects the transaction state stored in Classic Academy Finance.</div>
          <div>Voided or refunded transactions do not reduce an invoice balance.</div>
        </div>
        <div class="mini" style="text-align:right"><div class="strong">Finance Office</div><div style="margin-top:12px;border-top:1px solid #bbb;width:220px"></div></div>
      </div>
    </div>
  </section>
</div>
<script src="/js/finance-receipt.js"></script>
</body>
</html>
