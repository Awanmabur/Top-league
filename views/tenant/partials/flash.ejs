<link rel="stylesheet" href="/css/flash.css">
<div id="flash-container">
  <% const FLASH = (typeof flash !== "undefined" && flash) ? flash : {success:[], error:[], info:[], welcome:[], logout:[], warning:[]}; %>
  <%
    const flashGroups = [
      ["error", "flash-error"],
      ["success", "flash-success"],
      ["info", "flash-info"],
      ["welcome", "flash-success"],
      ["logout", "flash-success"],
      ["warning", "flash-warning"],
    ];
  %>
  <% flashGroups.forEach(function(entry) { const key = entry[0], cls = entry[1], messages = FLASH[key]; if (messages && messages.length) { %>
    <div id="flash-<%= key %>" class="<%= cls %>">
      <button class="flash-close" type="button" data-dismiss-parent aria-label="Dismiss message">&times;</button>
      <%= messages.join(" • ") %>
    </div>
  <% } }); %>
</div>
