<!DOCTYPE html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Academic Programs</title><link rel="stylesheet" href="/css/navbar.css"><link rel="stylesheet" href="/css/student-portal.css"><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"></head><body>
<%- include('../partials/navbar') %>
<main class="portal-main" style="max-width:1280px;margin:0 auto;padding:24px">
  <div style="display:flex;justify-content:space-between;gap:12px;align-items:center;flex-wrap:wrap"><div><h1>Academic Programs</h1><p>Canonical program catalog used by finance, scholarships and student records.</p></div><a class="btn" href="/admin/programs/export.csv">Export CSV</a></div>
  <% (messages?.success||[]).forEach(function(m){ %><div class="alert alert-success"><%= m %></div><% }) %><% (messages?.error||[]).forEach(function(m){ %><div class="alert alert-danger"><%= m %></div><% }) %>
  <section style="display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:12px;margin:18px 0"><div class="card"><b><%= kpis.total %></b><div>Total</div></div><div class="card"><b><%= kpis.active %></b><div>Active</div></div><div class="card"><b><%= kpis.referenced %></b><div>Referenced</div></div><div class="card"><b><%= kpis.quarantined %></b><div>Recovered / review</div></div></section>
  <section class="card" style="margin-bottom:18px"><h2>Create program</h2><form method="post" action="/admin/programs" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:10px"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input name="name" placeholder="Program name" required><input name="code" placeholder="Code" required><input name="shortTitle" placeholder="Short title"><select name="levelType"><option value="mixed">Mixed</option><option value="nursery">Nursery</option><option value="primary">Primary</option><option value="secondary">Secondary</option><option value="other">Other</option></select><input name="classLevels" placeholder="Class levels, comma separated"><select name="status"><option value="active">Active</option><option value="inactive">Inactive</option></select><textarea name="description" placeholder="Description" style="grid-column:1/-1"></textarea><button class="btn" type="submit">Create program</button></form></section>
  <form method="get" style="display:flex;gap:8px;flex-wrap:wrap;margin-bottom:14px"><input name="q" value="<%= query.q %>" placeholder="Search programs"><select name="status"><option value="all">All statuses</option><% ['active','inactive','archived'].forEach(function(s){ %><option value="<%= s %>" <%= query.status===s?'selected':'' %>><%= s %></option><% }) %></select><button class="btn" type="submit">Filter</button></form>
  <section style="display:grid;gap:14px"><% programs.forEach(function(p){ %><article class="card"><form method="post" action="/admin/programs/<%= p.id %>/update" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:8px"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="revision" value="<%= p.revision %>"><input name="name" value="<%= p.name %>" required><input name="code" value="<%= p.code %>" required><input name="shortTitle" value="<%= p.shortTitle %>"><select name="levelType"><% ['mixed','nursery','primary','secondary','other'].forEach(function(s){ %><option value="<%= s %>" <%= p.levelType===s?'selected':'' %>><%= s %></option><% }) %></select><input name="classLevels" value="<%= p.classLevels %>"><select name="status"><% ['active','inactive','archived'].forEach(function(s){ %><option value="<%= s %>" <%= p.status===s?'selected':'' %>><%= s %></option><% }) %></select><textarea name="description" style="grid-column:1/-1"><%= p.description %></textarea><div style="grid-column:1/-1">References: <b><%= p.refs.total %></b><% if(p.legacy){ %> · legacy subject projection<% } %><% if(p.quarantined){ %> · <b>review required</b><% } %></div><button class="btn" type="submit">Save</button></form><div style="display:flex;gap:8px;margin-top:8px;flex-wrap:wrap"><form method="post" action="/admin/programs/<%= p.id %>/status"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="revision" value="<%= p.revision %>"><input type="hidden" name="status" value="<%= p.status==='active'?'inactive':'active' %>"><button class="btn" type="submit"><%= p.status==='active'?'Deactivate':'Activate' %></button></form><form method="post" action="/admin/programs/<%= p.id %>/delete" data-confirm="Delete this unreferenced program?"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="revision" value="<%= p.revision %>"><button class="btn" type="submit">Delete</button></form></div></article><% }) %><% if(!programs.length){ %><div class="card">No programs found.</div><% } %></section>
</main></body></html>
