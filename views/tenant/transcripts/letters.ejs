<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Official Letters — <%= tenant?.name || 'Classic Academy' %></title><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"><link rel="stylesheet" href="/css/navbar.css"><link rel="stylesheet" href="/css/student-portal.css">  <link rel="stylesheet" href="/css/tenant-controls.css">
</head><body data-portal="tenant"><div class="app"><%- include('../partials/navbar') %><main class="main">
<div class="topbar"><div><div class="title">Official Letter Requests</div><div class="subtitle">Review, approve, release and mark collection of student letters.</div></div><a class="btn" href="/admin/transcripts">Back to Transcripts</a></div>
<% (messages.success||[]).forEach(function(m){ %><div class="card" style="margin:8px 0"><%= m %></div><% }); (messages.error||[]).forEach(function(m){ %><div class="card" style="margin:8px 0"><strong><%= m %></strong></div><% }); %>
<section class="card" style="margin-top:12px"><div style="overflow:auto"><table style="width:100%"><thead><tr><th>Request</th><th>Student</th><th>Type / Purpose</th><th>Status</th><th>Registry action</th></tr></thead><tbody><% if(requests.length){ requests.forEach(function(r){ const s=r.studentId||{}; const next={Pending:['Approved','Rejected'],Approved:['Ready','Rejected'],Ready:['Collected'],Rejected:[],Collected:[],Cancelled:[]}[r.status]||[]; %><tr><td><strong><%= r.requestNumber %></strong><div class="small-muted"><%= new Date(r.requestedAt||r.createdAt).toLocaleString() %></div></td><td><%= s.fullName || [s.firstName,s.lastName].filter(Boolean).join(' ') || s.regNo || s.studentNo || 'Student' %><div class="small-muted"><%= s.classLevel || '' %> • <%= r.academicYear %> T<%= r.term %></div></td><td><strong><%= r.type %></strong><div class="small-muted"><%= r.purpose || 'No purpose supplied' %></div></td><td><%= r.status %></td><td><% if(next.length){ %><form method="post" action="/admin/transcripts/letters/<%= r._id %>/status" style="display:flex;gap:5px;flex-wrap:wrap"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="revision" value="<%= r.revision %>"><select name="status"><% next.forEach(function(x){ %><option><%= x %></option><% }) %></select><input name="note" maxlength="500" placeholder="Registry note"><button class="btn primary">Save</button></form><% } else { %>—<% } %></td></tr><% }); } else { %><tr><td colspan="5">No letter requests yet.</td></tr><% } %></tbody></table></div></section>
</main></div><script src="/js/navbar.js"></script>  <script src="/js/tenant-workspace-motion.js" defer></script>
</body></html>
