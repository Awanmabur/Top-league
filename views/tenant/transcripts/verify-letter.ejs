<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Verify Official Letter — <%= tenant?.name || 'Classic Academy' %></title><link rel="stylesheet" href="/css/student-portal.css">  <link rel="stylesheet" href="/css/tenant-controls.css">
</head><body><main class="main" style="max-width:760px;margin:40px auto"><section class="card"><div class="title">Official Letter Verification</div><% if(ok && minimal){ %><p><strong>Valid document</strong></p><div class="mini-list"><div class="mini-item"><span>Reference</span><span><%= minimal.requestNumber %></span></div><div class="mini-item"><span>Letter</span><span><%= minimal.type %></span></div><div class="mini-item"><span>Student</span><span><%= minimal.studentName %></span></div><div class="mini-item"><span>Academic period</span><span><%= minimal.academicYear %> T<%= minimal.term %></span></div><div class="mini-item"><span>Status</span><span><%= minimal.status %></span></div></div><% } else { %><p><strong>Verification failed.</strong> <%= reason %></p><% } %></section></main>  <script src="/js/tenant-workspace-motion.js" defer></script>
</body></html>
