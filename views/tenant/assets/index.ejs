<!DOCTYPE html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Assets - <%= tenant?.name || 'Classic Academy' %></title><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" crossorigin="anonymous" referrerpolicy="no-referrer"><link rel="stylesheet" href="/css/student-portal.css"><link rel="stylesheet" href="/css/navbar.css"><style>.grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px}.field{display:grid;gap:5px}.field input,.field select,.field textarea{padding:10px 12px;border:1px solid rgba(13,64,96,.16);border-radius:10px;width:100%}.field label{font-size:12px;font-weight:800;color:#6b7280}.full{grid-column:1/-1}.table-wrap{overflow:auto;border:1px solid rgba(13,64,96,.1);border-radius:12px}table{width:100%;border-collapse:collapse;min-width:1100px}th,td{padding:10px 12px;border-bottom:1px solid rgba(13,64,96,.08);text-align:left;font-size:13px}th{font-size:12px;color:#6b7280;text-transform:uppercase;background:rgba(13,64,96,.03)}details{margin-top:6px}summary{cursor:pointer;font-weight:800}.actions{display:flex;gap:8px;flex-wrap:wrap}@media(max-width:900px){.grid{grid-template-columns:1fr}}</style></head><body data-portal="tenant"><%- include('../partials/flash') %><%- include('../partials/navbar') %><main class="main"><div class="topbar"><div><div class="title">Assets & Maintenance</div><div class="subtitle">Track inventory, assignments, returns, repairs and disposal from one authoritative record.</div></div><a class="btn light" href="/admin/assets/export.csv">Export CSV</a></div><div class="kpi-row"><div class="card"><div class="section-title">Assets</div><div class="kpi-value"><%= kpis.assets %></div></div><div class="card"><div class="section-title">Assigned</div><div class="kpi-value"><%= kpis.assigned %></div></div><div class="card"><div class="section-title">Maintenance</div><div class="kpi-value"><%= kpis.maintenance %></div></div><div class="card"><div class="section-title">Book Value</div><div class="kpi-value"><%= Number(kpis.totalValue||0).toLocaleString() %></div></div></div>
<section class="card"><div class="section-title">Register Asset</div><form method="POST" action="/admin/assets" class="grid"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="field"><label>Asset Tag</label><input name="assetTag" required></div><div class="field"><label>Name</label><input name="name" required></div><div class="field"><label>Category</label><select name="category"><% ['Furniture','Electronics','Vehicle','Lab Equipment','ICT','Office Equipment','Library','Sports','Other'].forEach(function(c){ %><option><%= c %></option><% }) %></select></div><div class="field"><label>Quantity</label><input type="number" min="1" name="quantity" value="1" required></div><div class="field"><label>Brand</label><input name="brand"></div><div class="field"><label>Model</label><input name="model"></div><div class="field"><label>Serial Number</label><input name="serialNumber"></div><div class="field"><label>Unit Cost</label><input type="number" min="0" step="0.01" name="unitCost" value="0"></div><div class="field"><label>Purchase Date</label><input type="date" name="purchaseDate"></div><div class="field"><label>Supplier</label><input name="supplier"></div><div class="field"><label>Location</label><input name="location"></div><div class="field"><label>Condition</label><select name="condition"><% ['Excellent','Good','Fair','Damaged'].forEach(function(c){ %><option <%= c==='Good'?'selected':'' %>><%= c %></option><% }) %></select></div><div class="field full"><label>Notes</label><textarea name="notes"></textarea></div><div class="field full"><button class="btn primary" type="submit">Register Asset</button></div></form></section>
<section class="card"><form method="GET" action="/admin/assets" class="actions"><input class="input" name="q" value="<%= query.q || '' %>" placeholder="Search tag, name, serial, location..."><select class="select" name="category"><option value="all">All categories</option><% categories.forEach(function(c){ %><option value="<%= c %>" <%= query.category===c?'selected':'' %>><%= c %></option><% }) %></select><select class="select" name="status"><option value="all">All statuses</option><% ['Available','Assigned','Maintenance','Disposed'].forEach(function(s){ %><option value="<%= s %>" <%= query.status===s?'selected':'' %>><%= s %></option><% }) %></select><button class="btn light" type="submit">Filter</button><a class="btn light" href="/admin/assets">Reset</a></form><div class="table-wrap"><table><thead><tr><th>Asset</th><th>Category</th><th>Quantity</th><th>Assigned</th><th>Status</th><th>Condition</th><th>Location</th><th>Manage</th></tr></thead><tbody><% if(!assets.length){ %><tr><td colspan="8">No assets found.</td></tr><% } %><% assets.forEach(function(a){ const used=(a.assignments||[]).filter(x=>x.status==='Assigned'&&!x.returnedAt).reduce((n,x)=>n+Number(x.quantity||1),0); %><tr><td><strong><%= a.assetTag %></strong><br><span class="muted"><%= a.name %></span></td><td><%= a.category %></td><td><%= a.quantity %></td><td><%= used %></td><td><%= a.status %></td><td><%= a.condition %></td><td><%= a.location || '—' %></td><td><details><summary>Manage</summary><form method="POST" action="/admin/assets/<%= a._id %>/update" class="grid"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="revision" value="<%= a.revision %>"><div class="field"><label>Tag</label><input name="assetTag" value="<%= a.assetTag %>" required></div><div class="field"><label>Name</label><input name="name" value="<%= a.name %>" required></div><div class="field"><label>Category</label><select name="category"><% ['Furniture','Electronics','Vehicle','Lab Equipment','ICT','Office Equipment','Library','Sports','Other'].forEach(function(c){ %><option <%= a.category===c?'selected':'' %>><%= c %></option><% }) %></select></div><div class="field"><label>Quantity</label><input type="number" min="1" name="quantity" value="<%= a.quantity %>" required></div><div class="field"><label>Brand</label><input name="brand" value="<%= a.brand || '' %>"></div><div class="field"><label>Model</label><input name="model" value="<%= a.model || '' %>"></div><div class="field"><label>Serial</label><input name="serialNumber" value="<%= a.serialNumber || '' %>"></div><div class="field"><label>Unit Cost</label><input type="number" min="0" step="0.01" name="unitCost" value="<%= a.unitCost || 0 %>"></div><div class="field"><label>Purchase Date</label><input type="date" name="purchaseDate" value="<%= helpers.dateOnly(a.purchaseDate) %>"></div><div class="field"><label>Supplier</label><input name="supplier" value="<%= a.supplier || '' %>"></div><div class="field"><label>Location</label><input name="location" value="<%= a.location || '' %>"></div><div class="field"><label>Condition</label><select name="condition"><% ['Excellent','Good','Fair','Damaged'].forEach(function(c){ %><option <%= a.condition===c?'selected':'' %>><%= c %></option><% }) %></select></div><div class="field full"><label>Notes</label><textarea name="notes"><%= a.notes || '' %></textarea></div><div class="field full"><button class="btn primary" type="submit">Save Asset</button></div></form><% if(a.status!=='Maintenance'&&a.status!=='Disposed'&&used<a.quantity){ %><form method="POST" action="/admin/assets/<%= a._id %>/assign" class="grid"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="revision" value="<%= a.revision %>"><div class="field"><label>Type</label><select name="assigneeType"><option>Staff</option><option>Student</option><option>Department</option><option>Office</option><option>Other</option></select></div><div class="field"><label>Known Student/Staff ID (optional)</label><select name="assigneeId"><option value="">Use typed name below</option><optgroup label="Students"><% students.forEach(function(s){ %><option value="<%= s._id %>"><%= s.fullName || s.regNo %> — student</option><% }) %></optgroup><optgroup label="Staff"><% staff.forEach(function(s){ %><option value="<%= s._id %>"><%= [s.firstName,s.lastName].filter(Boolean).join(' ') || s.email %> — staff</option><% }) %></optgroup></select></div><div class="field"><label>Assigned To</label><input name="assignedTo" placeholder="Required for department/office/other"></div><div class="field"><label>Quantity</label><input type="number" name="quantity" min="1" max="<%= Math.max(1,a.quantity-used) %>" value="1"></div><div class="field"><label>Due Back</label><input type="date" name="dueBackAt"></div><div class="field full"><label>Note</label><textarea name="note"></textarea></div><div class="field full"><button class="btn light" type="submit">Assign</button></div></form><% } %><% if(a.status==='Available'&&used===0){ %><form method="POST" action="/admin/assets/<%= a._id %>/maintenance" class="grid"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="revision" value="<%= a.revision %>"><div class="field"><label>Maintenance Title</label><input name="title" required></div><div class="field"><label>Priority</label><select name="priority"><option>normal</option><option>low</option><option>high</option><option>urgent</option></select></div><div class="field"><label>Vendor</label><input name="vendor"></div><div class="field"><label>Estimated/Actual Cost</label><input type="number" min="0" step="0.01" name="cost"></div><div class="field full"><label>Description</label><textarea name="description"></textarea></div><div class="field full"><button class="btn light" type="submit">Open Maintenance</button></div></form><form method="POST" action="/admin/assets/<%= a._id %>/dispose"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="revision" value="<%= a.revision %>"><input class="input" name="reason" placeholder="Disposal reason" required><button class="btn light" type="submit">Dispose</button></form><% } %><% if(a.status==='Disposed'){ %><form method="POST" action="/admin/assets/<%= a._id %>/archive"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="revision" value="<%= a.revision %>"><button class="btn light" type="submit">Archive disposed asset</button></form><% } %></details></td></tr><% }) %></tbody></table></div></section>
<section class="card"><div class="section-title">Assignments & Returns</div><div class="table-wrap"><table><thead><tr><th>Asset</th><th>Assigned To</th><th>Type</th><th>Qty</th><th>Assigned</th><th>Due</th><th>Status</th><th>Action</th></tr></thead><tbody><% if(!assignments.length){ %><tr><td colspan="8">No assignments yet.</td></tr><% } %><% assignments.forEach(function(x){ const asset=assets.find(a=>String(a._id)===String(x.assetId)); %><tr><td><strong><%= x.assetTag %></strong><br><span class="muted"><%= x.assetName %></span></td><td><%= x.assignedTo %></td><td><%= x.assigneeType %></td><td><%= x.quantity || 1 %></td><td><%= helpers.dateOnly(x.assignedAt) || '—' %></td><td><%= helpers.dateOnly(x.dueBackAt) || '—' %></td><td><%= x.status %></td><td><% if(x.status==='Assigned'&&asset){ %><form method="POST" action="/admin/assets/<%= x.assetId %>/assignments/<%= x._id %>/return"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="revision" value="<%= asset.revision %>"><button class="btn-xs" type="submit">Return</button></form><% } else { %>—<% } %></td></tr><% }) %></tbody></table></div></section>
<section class="card"><div class="section-title">Maintenance</div><div class="table-wrap"><table><thead><tr><th>Ticket</th><th>Asset</th><th>Title</th><th>Priority</th><th>Status</th><th>Cost</th><th>Opened</th><th>Manage</th></tr></thead><tbody><% if(!maintenance.length){ %><tr><td colspan="8">No maintenance tickets.</td></tr><% } %><% maintenance.forEach(function(m){ %><tr><td><strong><%= m.ticketCode %></strong></td><td><%= m.asset?.assetTag || '—' %><br><span class="muted"><%= m.asset?.name || '' %></span></td><td><%= m.title %></td><td><%= m.priority %></td><td><%= m.status %></td><td><%= Number(m.cost||0).toLocaleString() %></td><td><%= helpers.dateOnly(m.openedAt) %></td><td><% if(!['resolved','cancelled'].includes(m.status)){ %><form method="POST" action="/admin/assets/maintenance/<%= m._id %>" class="grid"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="revision" value="<%= m.revision %>"><div class="field"><label>Status</label><select name="status"><option value="open" <%= m.status==='open'?'selected':'' %>>open</option><option value="in_progress" <%= m.status==='in_progress'?'selected':'' %>>in progress</option><option value="resolved">resolved</option><option value="cancelled">cancelled</option></select></div><div class="field"><label>Priority</label><select name="priority"><% ['low','normal','high','urgent'].forEach(function(p){ %><option <%= m.priority===p?'selected':'' %>><%= p %></option><% }) %></select></div><div class="field"><label>Cost</label><input type="number" min="0" step="0.01" name="cost" value="<%= m.cost || 0 %>"></div><div class="field"><label>Vendor</label><input name="vendor" value="<%= m.vendor || '' %>"></div><input type="hidden" name="title" value="<%= m.title %>"><input type="hidden" name="description" value="<%= m.description || '' %>"><div class="field full"><label>Resolution</label><textarea name="resolution"><%= m.resolution || '' %></textarea></div><div class="field full"><button class="btn-xs" type="submit">Update Ticket</button></div></form><% } else { %><span class="muted"><%= m.resolution || 'Closed' %></span><% } %></td></tr><% }) %></tbody></table></div></section></main><script src="/js/navbar.js"></script></body></html>
