<!DOCTYPE html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Transport - <%= tenant?.name || 'Classic Academy' %></title><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" crossorigin="anonymous" referrerpolicy="no-referrer"><link rel="stylesheet" href="/css/navbar.css"><link rel="stylesheet" href="/css/student-portal.css"><style nonce="<%= cspNonce %>">.table-wrap{overflow:auto;border:1px solid rgba(13,64,96,.10);border-radius:12px}table{width:100%;border-collapse:collapse;min-width:1100px;background:#fff}th,td{padding:10px 12px;border-bottom:1px solid rgba(13,64,96,.08);text-align:left;font-size:13px}th{font-size:12px;color:#6b7280;text-transform:uppercase;background:rgba(13,64,96,.03)}.form-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px}.field{display:grid;gap:5px}.field label{font-size:12px;color:#6b7280;font-weight:800}.field input,.field select,.field textarea{width:100%;padding:10px 12px;border:1px solid rgba(13,64,96,.16);border-radius:10px}.field.full{grid-column:1/-1}.actions{display:flex;gap:8px;flex-wrap:wrap}details{margin-top:8px}summary{cursor:pointer;font-weight:800}@media(max-width:900px){.form-grid{grid-template-columns:1fr}}</style>  <link rel="stylesheet" href="/css/tenant-controls.css">
</head><body data-portal="tenant"><%- include('../partials/flash') %><%- include('../partials/navbar') %><main class="main"><div class="topbar"><div><div class="title">Transport</div><div class="subtitle">Real learner assignments, capacity protection, routes, vehicles and pickup points.</div></div></div><div class="kpi-row"><div class="card"><div class="section-title">Routes</div><div class="kpi-value"><%= kpis.routes %></div></div><div class="card"><div class="section-title">Active</div><div class="kpi-value"><%= kpis.active %></div></div><div class="card"><div class="section-title">Committed Learners</div><div class="kpi-value"><%= kpis.learners %></div></div><div class="card"><div class="section-title">Capacity</div><div class="kpi-value"><%= kpis.capacity %></div></div></div>
<section class="card"><div class="section-title">Add Route</div><form method="POST" action="/admin/transport" class="form-grid"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="field"><label>Route Name</label><input name="routeName" required></div><div class="field"><label>Route Code</label><input name="routeCode" required></div><div class="field"><label>Vehicle</label><input name="vehicleName"></div><div class="field"><label>Registration No.</label><input name="vehicleRegNo"></div><div class="field"><label>Driver</label><input name="driverName"></div><div class="field"><label>Driver Phone</label><input name="driverPhone"></div><div class="field"><label>Capacity</label><input name="capacity" type="number" min="1" value="1" required></div><div class="field"><label>Fee Amount</label><input name="feeAmount" type="number" min="0" step="0.01"></div><div class="field"><label>Status</label><select name="status"><option value="inactive">Inactive / Draft</option><option value="active">Active</option><option value="maintenance">Maintenance</option></select></div><div class="field full"><label>Pickup Points</label><textarea name="pickupPoints" placeholder="One pickup point per line" required></textarea></div><div class="field full"><label>Notes</label><textarea name="notes"></textarea></div><div class="field full"><button class="btn primary" type="submit">Add Route</button></div></form></section>
<section class="card"><form method="GET" action="/admin/transport" class="actions"><input class="input" name="q" value="<%= query.q || '' %>" placeholder="Search route, vehicle, driver..."><select class="select" name="status"><option value="">All Statuses</option><% ['active','inactive','maintenance','archived'].forEach(function(s){ %><option value="<%= s %>" <%= query.status===s?'selected':'' %>><%= s %></option><% }) %></select><button class="btn light" type="submit">Filter</button><a class="btn light" href="/admin/transport">Reset</a></form><div class="table-wrap"><table><thead><tr><th>Route</th><th>Vehicle</th><th>Driver</th><th>Pickup</th><th>Seats</th><th>Fee</th><th>Status</th><th>Manage</th></tr></thead><tbody><% if (!routes.length) { %><tr><td colspan="8">No transport routes found.</td></tr><% } %><% routes.forEach(function(route){ %><tr><td><strong><%= route.routeName %></strong><br><span class="muted"><%= route.routeCode %></span><% if (route.legacyAssignedLearners) { %><br><span class="muted"><%= route.legacyAssignedLearners %> legacy seat(s) reserved pending reconciliation</span><% } %></td><td><%= route.vehicleName || '—' %><br><span class="muted"><%= route.vehicleRegNo || '' %></span></td><td><%= route.driverName || '—' %><br><span class="muted"><%= route.driverPhone || '' %></span></td><td><%= (route.pickupPoints||[]).join(', ') || '—' %></td><td><%= route.committedSeats %> / <%= route.capacity %><br><span class="muted"><%= route.availableSeats %> available</span></td><td><%= Number(route.feeAmount||0).toLocaleString() %></td><td><%= route.status %></td><td><details><summary>Manage</summary><form method="POST" action="/admin/transport/<%= route._id %>" class="form-grid"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="revision" value="<%= route.revision %>"><div class="field"><label>Name</label><input name="routeName" value="<%= route.routeName %>" required></div><div class="field"><label>Code</label><input name="routeCode" value="<%= route.routeCode %>" required></div><div class="field"><label>Vehicle</label><input name="vehicleName" value="<%= route.vehicleName || '' %>"></div><div class="field"><label>Reg No.</label><input name="vehicleRegNo" value="<%= route.vehicleRegNo || '' %>"></div><div class="field"><label>Driver</label><input name="driverName" value="<%= route.driverName || '' %>"></div><div class="field"><label>Driver Phone</label><input name="driverPhone" value="<%= route.driverPhone || '' %>"></div><div class="field"><label>Capacity</label><input name="capacity" type="number" min="1" value="<%= route.capacity %>" required></div><div class="field"><label>Fee</label><input name="feeAmount" type="number" min="0" step="0.01" value="<%= route.feeAmount || 0 %>"></div><div class="field"><label>Status</label><select name="status"><% ['active','inactive','maintenance','archived'].forEach(function(s){ %><option value="<%= s %>" <%= route.status===s?'selected':'' %>><%= s %></option><% }) %></select></div><div class="field full"><label>Pickup Points</label><textarea name="pickupPoints"><%= (route.pickupPoints||[]).join('\n') %></textarea></div><div class="field full"><label>Notes</label><textarea name="notes"><%= route.notes || '' %></textarea></div><div class="field full"><button class="btn primary" type="submit">Save</button></div></form><% if(route.status==='active' && route.availableSeats>0){ %><form method="POST" action="/admin/transport/<%= route._id %>/assign" class="form-grid"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="routeRevision" value="<%= route.revision %>"><div class="field"><label>Student</label><select name="studentId" required><option value="">Select learner</option><% students.forEach(function(s){ %><option value="<%= s._id %>"><%= s.fullName || s.regNo %> — <%= s.regNo || '' %></option><% }) %></select></div><div class="field"><label>Pickup Point</label><select name="pickupPoint" required><option value="">Select pickup</option><% (route.pickupPoints||[]).forEach(function(p){ %><option value="<%= p %>"><%= p %></option><% }) %></select></div><div class="field full"><button class="btn light" type="submit">Assign Learner</button></div></form><% } %><% if(route.status==='inactive'&&!route.firstActivatedAt&&!route.legacyAssignedLearners){ %><form method="POST" action="/admin/transport/<%= route._id %>/delete"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="revision" value="<%= route.revision %>"><button class="btn light" type="submit">Permanently delete unused draft</button></form><% } %></details></td></tr><% }) %></tbody></table></div></section>
<section class="card"><div class="section-title">Learner Assignments</div><div class="table-wrap"><table><thead><tr><th>Student</th><th>Route</th><th>Pickup</th><th>Fee Snapshot</th><th>Status</th><th>Started</th><th>Action</th></tr></thead><tbody><% if(!assignments.length){ %><tr><td colspan="7">No transport assignments yet.</td></tr><% } %><% assignments.forEach(function(a){ %><tr><td><strong><%= a.student?.fullName || a.studentName || 'Student' %></strong><br><span class="muted"><%= a.student?.regNo || a.studentRegNo || '' %></span></td><td><%= a.route?.routeName || '—' %><br><span class="muted"><%= a.route?.routeCode || '' %></span></td><td><%= a.pickupPoint %></td><td><%= Number(a.feeAmountSnapshot||0).toLocaleString() %></td><td><%= a.status %></td><td><%= a.startedAt ? new Date(a.startedAt).toISOString().slice(0,10) : '—' %></td><td><% if(a.status==='active'){ %><form method="POST" action="/admin/transport/assignments/<%= a._id %>/end"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="revision" value="<%= a.revision %>"><button class="btn-xs" type="submit">End</button></form><% } else { %>—<% } %></td></tr><% }) %></tbody></table></div></section></main><script src="/js/navbar.js"></script>  <script src="/js/tenant-workspace-motion.js" defer></script>
</body></html>
