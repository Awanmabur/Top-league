<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <title>Hostel Report — <%= tenant?.name || "Classic Academy" %></title>
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
  <link rel="stylesheet" href="/css/navbar.css" />
  <link rel="stylesheet" href="/css/student-portal.css" />
  <link rel="stylesheet" href="/css/tenant-controls.css">
</head>
<body>
  <%- include("../partials/navbar") %>
  <main class="main">
    <div class="topbar">
      <div><div class="title">Hostel Report</div><div class="subtitle">Current room capacity, applications, allocations and maintenance.</div></div>
      <div class="top-actions">
        <a class="btn light" href="/admin/hostels"><i class="fa-solid fa-arrow-left"></i> Hostels</a>
        <a class="btn light" href="/admin/hostels/export.csv"><i class="fa-solid fa-file-csv"></i> CSV</a>
        <button class="btn primary" type="button" id="btnPrint"><i class="fa-solid fa-print"></i> Print</button>
      </div>
    </div>

    <div class="grid-4">
      <div class="card"><div class="section-title">Rooms</div><div class="kpi-value"><%= kpis.rooms %></div></div>
      <div class="card"><div class="section-title">Beds</div><div class="kpi-value"><%= kpis.beds %></div></div>
      <div class="card"><div class="section-title">Occupied</div><div class="kpi-value"><%= kpis.occupied %></div></div>
      <div class="card"><div class="section-title">Pending / Waitlist</div><div class="kpi-value"><%= kpis.applications %></div></div>
    </div>

    <section class="card" style="margin-top:14px;">
      <div class="section-title">Room Capacity</div>
      <div class="table-wrap" style="margin-top:10px;">
        <table>
          <thead><tr><th>Block</th><th>Room</th><th>Gender</th><th>Type</th><th>Beds</th><th>Occupied</th><th>Status</th></tr></thead>
          <tbody>
            <% (allRooms || []).forEach(function(room){ %>
              <tr><td><%= room.block %></td><td><%= room.code %></td><td><%= room.gender %></td><td><%= room.type %></td><td><%= room.beds %></td><td><%= room.occupied %></td><td><%= room.status %></td></tr>
            <% }) %>
            <% if (!(allRooms || []).length) { %><tr><td colspan="7">No rooms found.</td></tr><% } %>
          </tbody>
        </table>
      </div>
    </section>

    <div class="content" style="margin-top:14px;">
      <section class="card">
        <div class="section-title">Recent Applications</div>
        <div class="mini-list" style="margin-top:10px;">
          <% (applications || []).slice(0,20).forEach(function(app){ %>
            <div class="mini-item"><span><%= app.applicationId %> • <%= app.studentName %></span><span><%= app.roomBlock %> • <%= app.roomCode %> • <%= app.status %></span></div>
          <% }) %>
          <% if (!(applications || []).length) { %><div class="small-muted">No applications.</div><% } %>
        </div>
      </section>
      <aside class="card">
        <div class="section-title">Maintenance</div>
        <div class="mini-list" style="margin-top:10px;">
          <% (maintenance || []).slice(0,20).forEach(function(row){ %>
            <div class="mini-item"><span><%= row.roomCode %> • <%= row.issue %></span><span><%= row.status %></span></div>
          <% }) %>
          <% if (!(maintenance || []).length) { %><div class="small-muted">No maintenance tickets.</div><% } %>
        </div>
      </aside>
    </div>
  </main>
  <script src="/js/hostel-report.js"></script>
  <script src="/js/navbar.js"></script>
  <script src="/js/tenant-workspace-motion.js" defer></script>
</body>
</html>
