<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Subject Registrations — <%= tenant?.name || 'Classic Academy' %></title><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"><link rel="stylesheet" href="/css/navbar.css"><link rel="stylesheet" href="/css/student-portal.css"></head>
<body data-portal="tenant"><div class="app"><%- include('../partials/navbar') %><main class="main">
<div class="topbar"><div><div class="title">Subject Registrations</div><div class="subtitle">Registration windows, student selections and blocking holds.</div></div><a class="btn" href="/admin/subjects">Back to Subjects</a></div>
<% (messages.success||[]).forEach(function(m){ %><div class="card" style="margin:8px 0;"><%= m %></div><% }); (messages.error||[]).forEach(function(m){ %><div class="card" style="margin:8px 0;"><strong><%= m %></strong></div><% }); %>
<section class="card" style="margin-top:12px;"><div class="section-title">Create registration window</div><form method="post" action="/admin/subjects/registrations/windows" style="display:flex;gap:8px;flex-wrap:wrap;margin-top:10px;"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input name="name" maxlength="160" placeholder="Window name"><input name="academicYear" maxlength="20" required placeholder="2026"><select name="term" required><option value="1">Term 1</option><option value="2">Term 2</option><option value="3">Term 3</option></select><select name="classId"><option value="">All classes / use level</option><% classes.forEach(function(c){ %><option value="<%= c._id %>"><%= c.name || c.code || c.classLevel || c._id %></option><% }) %></select><input name="classLevel" maxlength="20" placeholder="Class level fallback"><input name="opensAt" type="datetime-local" required><input name="closesAt" type="datetime-local" required><input name="maxOptionalSubjects" type="number" min="0" max="30" value="4"><select name="status"><option value="draft">Draft</option><option value="open">Open</option><option value="closed">Closed</option></select><label><input type="checkbox" name="allowDrop" checked> Allow drop</label><button class="btn primary" type="submit">Create</button></form></section>
<section class="card" style="margin-top:12px;"><div class="section-title">Windows</div><div style="overflow:auto"><table style="width:100%"><thead><tr><th>Name</th><th>Period</th><th>Scope</th><th>Dates</th><th>Status / Limit</th></tr></thead><tbody><% if(windows.length){ windows.forEach(function(w){ %><tr><td><strong><%= w.name %></strong></td><td><%= w.academicYear %> T<%= w.term %></td><td><%= w.classLevel || w.classId || 'All matching students' %></td><td><%= new Date(w.opensAt).toLocaleString() %><br><%= new Date(w.closesAt).toLocaleString() %></td><td><form method="post" action="/admin/subjects/registrations/windows/<%= w._id %>" style="display:flex;gap:5px;flex-wrap:wrap"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="revision" value="<%= w.revision %>"><select name="status"><% ['draft','open','closed'].forEach(function(x){ %><option value="<%= x %>" <%= w.status===x?'selected':'' %>><%= x %></option><% }) %></select><input type="number" name="maxOptionalSubjects" min="0" max="30" value="<%= w.maxOptionalSubjects %>" style="width:65px"><label><input type="checkbox" name="allowDrop" <%= w.allowDrop?'checked':'' %>> drop</label><button class="btn" type="submit">Save</button></form></td></tr><% }); } else { %><tr><td colspan="5">No windows yet.</td></tr><% } %></tbody></table></div></section>
<section class="card" style="margin-top:12px;"><div class="section-title">Student selections</div><div style="overflow:auto"><table style="width:100%"><thead><tr><th>Student</th><th>Subject</th><th>Period</th><th>Status</th><th>Decision</th></tr></thead><tbody><% if(registrations.length){ registrations.forEach(function(r){ const st=r.studentId||{}; const sj=r.subjectId||{}; %><tr><td><%= st.fullName || [st.firstName,st.lastName].filter(Boolean).join(' ') || st.regNo || 'Student' %></td><td><strong><%= sj.code || r.subjectCode %></strong> <%= sj.title || r.subjectTitle %></td><td><%= r.academicYear %> T<%= r.term %></td><td><%= r.status %></td><td><% if(r.status==='pending'){ %><form method="post" action="/admin/subjects/registrations/<%= r._id %>/decision" style="display:flex;gap:5px"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="revision" value="<%= r.revision %>"><select name="status"><option value="approved">Approve</option><option value="rejected">Reject</option></select><input name="note" maxlength="500" placeholder="Note"><button class="btn primary">Save</button></form><% } else { %>—<% } %></td></tr><% }); } else { %><tr><td colspan="5">No registrations yet.</td></tr><% } %></tbody></table></div></section>
<section class="card" style="margin-top:12px;"><div class="section-title">Registration holds</div><form method="post" action="/admin/subjects/registrations/holds" style="display:flex;gap:8px;flex-wrap:wrap;margin-top:8px"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><select name="studentId" required><option value="">Select student</option><% students.forEach(function(s){ %><option value="<%= s._id %>"><%= s.fullName || [s.firstName,s.lastName].filter(Boolean).join(' ') || s.regNo || s.studentNo %></option><% }) %></select><select name="type"><option>academic</option><option>finance</option><option>discipline</option><option>documents</option><option>other</option></select><input name="reason" maxlength="500" required placeholder="Reason"><input name="expiresAt" type="datetime-local"><button class="btn primary">Add hold</button></form><div style="margin-top:10px"><% if(holds.length){ holds.forEach(function(h){ %><div class="notif-item"><div style="flex:1"><strong><%= h.studentId?.fullName || [h.studentId?.firstName,h.studentId?.lastName].filter(Boolean).join(' ') || 'Student' %></strong> — <%= h.type %>: <%= h.reason %></div><form method="post" action="/admin/subjects/registrations/holds/<%= h._id %>/clear"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="revision" value="<%= h.revision %>"><button class="btn">Clear</button></form></div><% }); } else { %><div class="small-muted">No active registration holds.</div><% } %></div></section>
</main></div><script src="/js/navbar.js"></script></body></html>
